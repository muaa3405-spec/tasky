<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration for Tasky (paste into SignPath → Project → Artifact configurations).
     CI uploads TaskySetup.exe as a GitHub artifact, which GitHub wraps in a zip; SignPath signs the
     installer inside and returns it. Signing is refused unless the file says it is "Tasky". -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="TaskySetup.exe" product-name="Tasky">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
