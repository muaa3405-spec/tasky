<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Tasky.ViewModels"
        xmlns:models="using:Tasky.Models"
        xmlns:beh="using:Tasky.Behaviors"
        xmlns:ctrl="using:Tasky.Controls"
        xmlns:helpers="using:Tasky.Helpers"
        x:Class="Tasky.MainWindow"
        Title="Tasky" Width="604" Height="681"
        MinWidth="444" MinHeight="421"
        Background="{DynamicResource AppBackground}"
        WindowStartupLocation="CenterScreen">
    <!-- Sizes are the inside (client) area: the original 620×720 window minus the Windows frame -->

    <Window.Resources>
        <!-- "Empty Bin" text link in the sub-page header -->
        <ControlTheme x:Key="EmptyBinLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <TextBlock Name="EbTxt" Text="Empty Bin" FontSize="13"
                               Background="Transparent"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ TextBlock#EbTxt">
                <Setter Property="Foreground" Value="#F87171"/>
            </Style>
        </ControlTheme>

        <!-- ☑ Completed tasks button next to the filter chips -->
        <ControlTheme x:Key="CompletedTasksButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" Background="Transparent"
                            CornerRadius="20" Padding="10,4" BorderThickness="0">
                        <TextBlock Text="&#x2611;" FontSize="16" Foreground="#34D399"
                                   VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#Bd">
                <Setter Property="Background" Value="{DynamicResource TagBackground}"/>
            </Style>
        </ControlTheme>

        <!-- Notifications / Upcoming Reminders tabs: icon in Tag, label in Content -->
        <ControlTheme x:Key="ReminderTab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" BorderThickness="0,0,0,3"
                            BorderBrush="Transparent" Padding="0,11"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ContentPresenter Content="{TemplateBinding Tag}" FontSize="13"
                                              Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <ContentPresenter Name="Lbl" Content="{TemplateBinding Content}"
                                              FontSize="13" FontWeight="SemiBold"
                                              Foreground="{DynamicResource TextSecondary}"
                                              VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:checked /template/ Border#Bd">
                <Setter Property="BorderBrush" Value="#60A5FA"/>
            </Style>
            <Style Selector="^:checked /template/ ContentPresenter#Lbl">
                <Setter Property="Foreground" Value="#60A5FA"/>
            </Style>
            <Style Selector="^:pointerover /template/ Border#Bd">
                <Setter Property="Background" Value="{DynamicResource TagBackground}"/>
            </Style>
        </ControlTheme>

        <!-- Recycle Bin entry on the Settings page: a whole card that is a button -->
        <ControlTheme x:Key="RecycleBinCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" Theme="{StaticResource TaskCard}" Padding="14,11">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="&#x1F5D1;" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Recycle Bin" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="View and restore deleted tasks"
                                           Theme="{StaticResource SubText}" Margin="0,1,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#x203A;" FontSize="18"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#Bd">
                <Setter Property="Opacity" Value="0.8"/>
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Window.Styles>
        <!-- New task cards fade in and slide up as they appear -->
        <Style Selector="ItemsControl#TaskListControl > ContentPresenter">
            <Style.Animations>
                <Animation Duration="0:0:0.25" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="Margin"  Value="0,12,0,0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="Margin"  Value="0,0,0,0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Description: two lines, or everything when expanded -->
        <Style Selector="TextBlock.taskDescription">
            <Setter Property="MaxHeight"    Value="36"/>
            <Setter Property="TextTrimming" Value="WordEllipsis"/>
        </Style>
        <Style Selector="TextBlock.taskDescription.expanded">
            <Setter Property="MaxHeight"    Value="9999"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>

        <!-- Running / paused timer on a task card -->
        <Style Selector="TextBlock.timerIcon">
            <Setter Property="Text"       Value="&#x23F1;"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
        </Style>
        <Style Selector="TextBlock.timerIcon.paused">
            <Setter Property="Text"       Value="&#x23F8;"/>
            <Setter Property="Foreground" Value="#F59E0B"/>
        </Style>
        <Style Selector="TextBlock.timerText">
            <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
        </Style>
        <Style Selector="TextBlock.timerText.paused">
            <Setter Property="Foreground" Value="#F59E0B"/>
        </Style>
        <Style Selector="TextBlock.pauseIcon">
            <Setter Property="Text" Value="&#x23F8;"/>
        </Style>
        <Style Selector="TextBlock.pauseIcon.paused">
            <Setter Property="Text" Value="&#x25B6;"/>
        </Style>

        <!-- The description box shows no placeholder while it is disabled (no title yet) -->
        <Style Selector="TextBox#DescInputBox:disabled /template/ TextBlock#PART_Watermark">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
    </Window.Styles>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- MAIN HEADER -->
        <Border x:Name="MainHeader" Grid.Row="0"
                Background="{DynamicResource HeaderBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/tasky-logo.png" Width="32" Height="32"
                           RenderOptions.BitmapInterpolationMode="HighQuality"
                           Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Tasky" Theme="{StaticResource HeadingText}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 🔔 Reminders — position 1 with missed-count badge -->
                    <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Reminders &amp; Notifications"
                            Click="Reminders_Click" Margin="0,0,4,0">
                        <Grid>
                            <TextBlock Text="&#x1F514;" FontSize="15" Foreground="#FB923C"/>
                            <Border x:Name="NotifBadge"
                                    Background="#EF4444" CornerRadius="7"
                                    MinWidth="14" Height="14"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-4,-4,0" Padding="3,0"
                                    IsVisible="{Binding HasMissedNotifs}">
                                <TextBlock x:Name="NotifBadgeText"
                                           Text="{Binding MissedNotifCount}"
                                           FontSize="9" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>
                    <!-- 📝 Notes -->
                    <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Notes"
                            Click="Notes_Click" Margin="0,0,4,0">
                        <TextBlock Text="&#x1F4DD;" FontSize="15" Foreground="#FCD34D"/>
                    </Button>
                    <!-- 📁 Groups -->
                    <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Manage Groups"
                            Click="Groups_Click" Margin="0,0,4,0">
                        <TextBlock Text="&#x1F4C1;" FontSize="15" Foreground="#60A5FA"/>
                    </Button>
                    <Border Width="1" Height="18" Background="{DynamicResource BorderColor}"
                            VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <!-- 📊 Stats -->
                    <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Stats &amp; Reports"
                            Click="Stats_Click" Margin="0,0,4,0">
                        <TextBlock Text="&#x1F4CA;" FontSize="15" Foreground="#A78BFA"/>
                    </Button>
                    <!-- ⚙ Settings -->
                    <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Settings"
                            Click="Settings_Click" Margin="0,0,2,0">
                        <TextBlock Text="&#x2699;" FontSize="16" Foreground="#94A3B8"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SUB-PAGE HEADER -->
        <Border x:Name="SubHeader" Grid.Row="0" IsVisible="False"
                Background="{DynamicResource HeaderBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Theme="{StaticResource SecondaryButton}"
                        Padding="12,7" Click="Back_Click" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2190;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Back" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1" x:Name="SubPageTitle"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- New Note: only visible on the Notes page -->
                    <Button x:Name="NewNoteBtn" Theme="{StaticResource PrimaryButton}"
                            Padding="10,6" Margin="0,0,6,0"
                            IsVisible="False"
                            Click="NewNote_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+" FontSize="16" Margin="0,-1,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="New Note" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Empty Bin: gray text link, only visible on the Recycle Bin page -->
                    <Button x:Name="EmptyBinBtn" Click="EmptyBin_Click" Margin="0,0,8,0"
                            Theme="{StaticResource EmptyBinLink}"
                            IsVisible="False" ToolTip.Tip="Permanently delete all items in the bin"/>
                    <Button Theme="{StaticResource IconButton}" Click="ThemeToggle_Click" Margin="0,0,2,0">
                        <TextBlock x:Name="SubThemeIcon" Text="&#x1F319;" FontSize="15"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ADD PANEL -->
        <Border x:Name="AddPanelBorder" Grid.Row="1"
                Background="{DynamicResource HeaderBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="14,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="AddToggleBtn"
                            HorizontalAlignment="Left" Theme="{StaticResource SecondaryButton}"
                            Padding="14,7" Content="&#x2795;  New Task" Click="AddToggle_Click"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Theme="{StaticResource FilterChip}" Content="All"
                                     IsChecked="{Binding FilterAll, Mode=OneWay}"
                                     Click="Filter_All_Click" GroupName="TF" Margin="0,0,5,0"/>
                        <RadioButton Theme="{StaticResource FilterChip}" Content="Today"
                                     IsChecked="{Binding FilterToday, Mode=OneWay}"
                                     Click="Filter_Today_Click" GroupName="TF" Margin="0,0,5,0"/>
                        <RadioButton Theme="{StaticResource FilterChip}" Content="This Week"
                                     IsChecked="{Binding FilterThisWeek, Mode=OneWay}"
                                     Click="Filter_ThisWeek_Click" GroupName="TF" Margin="0,0,5,0"/>
                        <Button ToolTip.Tip="Completed Tasks" Click="Completed_Click"
                                Theme="{StaticResource CompletedTasksButton}"/>
                    </StackPanel>
                </Grid>

                <!-- Add form -->
                <StackPanel x:Name="AddFormPanel" IsVisible="False" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title — full width -->
                        <TextBox Grid.Row="0" x:Name="TitleInputBox"
                                 Theme="{StaticResource InputBox}" Watermark="Task title..."
                                 Text="{Binding NewTitle}"
                                 KeyDown="TitleBox_KeyDown"/>

                        <!-- Description -->
                        <Grid Grid.Row="2">
                            <TextBox x:Name="DescInputBox"
                                     Theme="{StaticResource InputBox}"
                                     Watermark="Description (optional)..."
                                     Text="{Binding NewDescription}"
                                     IsEnabled="{Binding HasTitle}"
                                     MinHeight="44" MaxHeight="100" TextWrapping="Wrap"
                                     AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            <Border IsHitTestVisible="False" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    Background="{DynamicResource InputBackground}" Opacity="0.6"
                                    IsVisible="{Binding !HasTitle}">
                                <TextBlock Text="Enter a title first..." Foreground="{DynamicResource PlaceholderColor}"
                                           FontSize="13" FontStyle="Italic"
                                           VerticalAlignment="Center" Margin="12,0"/>
                            </Border>
                        </Grid>

                        <!-- Attachments: saved with the task when it is added -->
                        <ctrl:PendingAttachmentsPanel x:Name="NewTaskAttachments" Grid.Row="4" Margin="0,2,0,0"/>

                        <!-- Start / Group / Repeat -->
                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Start:" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0"/>
                                <CalendarDatePicker Theme="{StaticResource ThemedDatePicker}"
                                                    SelectedDate="{Binding NewDueDate, Mode=TwoWay}"
                                                    SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd"
                                                    FirstDayOfWeek="Monday"
                                                    Width="148" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Group:" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0"/>
                                <ComboBox x:Name="NewTaskGroupPicker" Theme="{StaticResource ThemedComboBox}"
                                          Width="110" FontSize="12"
                                          SelectionChanged="NewTaskGroup_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Repeat:" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0"/>
                                <ComboBox x:Name="NewTaskRecurrencePicker" Theme="{StaticResource ThemedComboBox}"
                                          Width="90" FontSize="12" SelectedIndex="0"
                                          SelectionChanged="NewTaskRecurrence_Changed">
                                    <ComboBoxItem Content="None"    Tag="0"/>
                                    <ComboBoxItem Content="Daily"   Tag="1"/>
                                    <ComboBoxItem Content="Weekly"  Tag="2"/>
                                    <ComboBoxItem Content="Monthly" Tag="3"/>
                                </ComboBox>
                                <TextBlock Text="&#x24D8;" Theme="{StaticResource InfoIcon}"
                                           ToolTip.Tip="{x:Static helpers:RecurrenceRules.Explanation}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Optional repeat end date (only for repeating tasks) + Add Task button on the right -->
                        <Grid Grid.Row="8" ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                        IsVisible="{Binding NewTaskRepeats}">
                                <TextBlock Text="Ends on:" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0"/>
                                <CalendarDatePicker Theme="{StaticResource ThemedDatePicker}"
                                                    SelectedDate="{Binding NewTaskRecurrenceEndDate, Mode=TwoWay}"
                                                    SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd"
                                                    FirstDayOfWeek="Monday" Watermark="No end date"
                                                    Width="148" FontSize="13"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Theme="{StaticResource PrimaryButton}"
                                    Command="{Binding AddTaskCommand}"
                                    Content="Add Task" Click="AddTask_Click"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- PAGE CONTAINER -->
        <Grid x:Name="PageContainer" Grid.Row="2">

            <!-- PAGE 1: Task list -->
            <Grid x:Name="TaskListPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Group filter chips — sticky bar -->
                <ScrollViewer x:Name="GroupFilterScroll" Grid.Row="0"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Background="{DynamicResource HeaderBackground}"
                              Padding="14,7" IsVisible="False">
                    <StackPanel x:Name="GroupChipsPanel" Orientation="Horizontal"/>
                </ScrollViewer>

                <!-- Task search bar -->
                <Border Grid.Row="1" Background="{DynamicResource HeaderBackground}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                        Padding="14,8">
                    <TextBox Theme="{StaticResource InputBox}" Watermark="🔍  Search tasks..."
                             Text="{Binding TaskSearch}"/>
                </Border>

                <!-- Empty state — shown when VisibleTasks is empty -->
                <StackPanel Grid.Row="2"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            IsVisible="{Binding !HasVisibleTasks}"
                            IsHitTestVisible="False">
                    <TextBlock Text="✓" FontSize="40" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}" Opacity="0.3"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding EmptyTasksMessage}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center" Opacity="0.6"/>
                </StackPanel>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto" Padding="14,10">
                    <ItemsControl x:Name="TaskListControl"
                                  ItemsSource="{Binding VisibleTasks}"
                                  beh:DragDropBehavior.IsEnabled="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:TaskItemViewModel">
                                <Border Theme="{StaticResource TaskCard}"
                                        Background="{Binding IsActive, Converter={StaticResource ActiveBgConv}}"
                                        Padding="0">
                                    <Grid>
                                        <!-- Left colour strip -->
                                        <Border Width="10" HorizontalAlignment="Left"
                                                CornerRadius="8,0,0,8" Margin="-1,0,0,0"
                                                IsVisible="{Binding GroupBadge, Converter={StaticResource HasText}}"
                                                Background="{Binding GroupBrush}"/>

                                        <Grid Margin="16,10,12,24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                      Theme="{StaticResource CheckmarkBox}"
                                                      VerticalAlignment="Top" Margin="0,3,8,0"
                                                      Click="Checkbox_Click"/>
                                            <ToggleButton Grid.Column="1" Theme="{StaticResource ActiveToggleSwitch}"
                                                          IsChecked="{Binding IsActive, Mode=OneWay}"
                                                          Click="ActiveToggle_Click"
                                                          VerticalAlignment="Top" Margin="0,3,10,0"/>
                                            <StackPanel Grid.Column="2" Cursor="Hand"
                                                        PointerReleased="TaskContent_Click">
                                                <WrapPanel Margin="0,0,0,3">
                                                    <Border Background="{DynamicResource TagBackground}"
                                                            CornerRadius="3" Padding="4,1" Margin="0,2,4,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TaskNumberDisplay}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TagForeground}"/>
                                                    </Border>
                                                    <!-- Start date badge -->
                                                    <Border CornerRadius="3" Padding="4,1" Margin="0,2,4,2" VerticalAlignment="Center"
                                                            IsVisible="{Binding DueDateTag, Converter={StaticResource HasText}}"
                                                            Background="{Binding DueDateBrush}">
                                                        <TextBlock Text="{Binding DueDateTag}"
                                                                   FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                                    </Border>
                                                    <!-- Recurrence badge -->
                                                    <Border CornerRadius="3" Padding="4,1" Margin="0,2,6,2" VerticalAlignment="Center"
                                                            IsVisible="{Binding RecurrenceDisplay, Converter={StaticResource HasText}}"
                                                            Background="{Binding RecurrenceBrush}"
                                                            ToolTip.Tip="{Binding RecurrenceTooltip}">
                                                        <TextBlock Text="{Binding RecurrenceDisplay}"
                                                                   FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                </WrapPanel>
                                                <StackPanel IsVisible="{Binding Description, Converter={StaticResource HasText}}"
                                                            Margin="0,2,0,0">
                                                    <TextBlock x:Name="TaskDescriptionText"
                                                               Text="{Binding Description}" TextWrapping="Wrap"
                                                               Theme="{StaticResource SubText}"
                                                               Classes="taskDescription"
                                                               Classes.expanded="{Binding IsDescriptionExpanded}"
                                                               beh:TextOverflow.Detect="True"/>
                                                    <!-- Only when the description is cut off, or to collapse it again -->
                                                    <Button Content="{Binding ShowMoreLabel}" HorizontalAlignment="Left"
                                                            Theme="{StaticResource PlainButton}"
                                                            Click="ShowMore_Click" Background="Transparent" BorderThickness="0"
                                                            Padding="0,2,0,0" Cursor="Hand"
                                                            Foreground="{DynamicResource PrimaryBlue}"
                                                            FontSize="11">
                                                        <Button.IsVisible>
                                                            <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                                <Binding Path="IsDescriptionExpanded"/>
                                                                <Binding ElementName="TaskDescriptionText" Path="(beh:TextOverflow.IsTrimmed)"/>
                                                            </MultiBinding>
                                                        </Button.IsVisible>
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                            IsVisible="{Binding IsActive}">
                                                    <TextBlock FontSize="11" Margin="0,0,4,0"
                                                               Classes="timerIcon" Classes.paused="{Binding IsPaused}"/>
                                                    <TextBlock Text="{Binding ElapsedDisplay}"
                                                               FontSize="11" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"
                                                               Classes="timerText" Classes.paused="{Binding IsPaused}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Pause / Resume"
                                                        Click="Pause_Click" Margin="0,0,1,0"
                                                        IsVisible="{Binding IsActive}">
                                                    <TextBlock FontSize="13" Foreground="#F59E0B"
                                                               Classes="pauseIcon" Classes.paused="{Binding IsPaused}"/>
                                                </Button>
                                                <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Attachments"
                                                        Click="Attachment_Click" Margin="0,0,1,0">
                                                    <TextBlock Text="&#x1F4CE;" FontSize="13" Foreground="#60A5FA"/>
                                                </Button>
                                                <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Edit"
                                                        Click="Edit_Click" Margin="0,0,1,0">
                                                    <TextBlock Text="&#x270F;" FontSize="13" Foreground="#A78BFA"/>
                                                </Button>
                                                <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Set reminder"
                                                        Click="Reminder_Click" Margin="0,0,1,0">
                                                    <TextBlock Text="&#x1F514;" FontSize="13" Foreground="#FCD34D"/>
                                                </Button>
                                                <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Delete"
                                                        Click="Delete_Click">
                                                    <TextBlock Text="&#x1F5D1;" FontSize="13" Foreground="#F87171"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Attachment + Reminder — bottom-right of card -->
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                    Margin="0,0,10,6" ZIndex="2">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0"
                                                        IsVisible="{Binding HasAttachments}">
                                                <TextBlock Text="&#x1F4CE;" FontSize="10" Margin="0,0,3,0"
                                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding AttachmentCountDisplay}" FontSize="10"
                                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        IsVisible="{Binding HasReminders}">
                                                <TextBlock Text="&#x1F514;" FontSize="10" Margin="0,0,3,0"
                                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ReminderCountDisplay}" FontSize="10"
                                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid><!-- end TaskListPage wrapper -->

            <!-- PAGE 2: Completed Tasks -->
            <Grid x:Name="CompletedPage" IsVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                        Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="CChipAll"  Theme="{StaticResource FilterChip}" Content="All"
                                         Tag="All" IsChecked="True" GroupName="CF" Margin="0,0,6,0"
                                         Click="CGroup_Click"/>
                            <RadioButton x:Name="CChipToday" Theme="{StaticResource FilterChip}" Content="Today"
                                         Tag="Today" GroupName="CF" Margin="0,0,6,0" Click="CGroup_Click"/>
                            <RadioButton x:Name="CChipWeek"  Theme="{StaticResource FilterChip}" Content="This Week"
                                         Tag="This Week" GroupName="CF" Margin="0,0,6,0" Click="CGroup_Click"/>
                            <RadioButton x:Name="CChipMonth" Theme="{StaticResource FilterChip}" Content="This Month"
                                         Tag="This Month" GroupName="CF" Margin="0,0,6,0" Click="CGroup_Click"/>
                            <!-- Specific date filter -->
                            <CalendarDatePicker x:Name="CompletedDatePicker"
                                                Theme="{StaticResource ThemedDatePicker}"
                                                Width="120" FontSize="12"
                                                SelectedDateChanged="CompletedDate_Changed"
                                                ToolTip.Tip="Filter by specific date"/>
                        </StackPanel>
                        <ComboBox x:Name="SortBox" Grid.Column="2"
                                  Theme="{StaticResource ThemedComboBox}" Width="160" FontSize="12"
                                  SelectedIndex="0"
                                  SelectionChanged="Sort_Changed">
                            <ComboBoxItem Content="Newest first"      Tag="newest"/>
                            <ComboBoxItem Content="Oldest first"      Tag="oldest"/>
                            <ComboBoxItem Content="Most time spent"   Tag="time_desc"/>
                            <ComboBoxItem Content="Least time spent"  Tag="time_asc"/>
                        </ComboBox>
                    </Grid>
                </Border>
                <!-- Completed search -->
                <Border Grid.Row="1" Background="{DynamicResource HeaderBackground}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                        Padding="14,8">
                    <TextBox Theme="{StaticResource InputBox}" Watermark="🔍  Search completed tasks..."
                             Text="{Binding CompletedSearch}"/>
                </Border>
                <!-- Empty state for completed list -->
                <StackPanel x:Name="CompletedEmptyState" Grid.Row="2"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            IsVisible="False" IsHitTestVisible="False">
                    <TextBlock Text="☑" FontSize="40" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}" Opacity="0.3"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="No completed tasks to show."
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center" Opacity="0.6"/>
                </StackPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="14,10">
                    <ItemsControl x:Name="CompletedList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:TaskItemViewModel">
                                <Border Theme="{StaticResource TaskCard}" Margin="0,0,0,8" Cursor="Hand"
                                        PointerReleased="CompletedTask_Click">
                                    <Grid Margin="12,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Background="{DynamicResource TagBackground}"
                                                        CornerRadius="3" Padding="5,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding TaskNumberDisplay}"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TagForeground}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding CompletedAtDisplay}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding TimeDisplay}" FontSize="11"
                                                           Foreground="{DynamicResource AccentGreen}"
                                                           FontFamily="{StaticResource MonoFont}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Theme="{StaticResource IconButton}"
                                                    ToolTip.Tip="Resume task (mark as incomplete)"
                                                    Click="Completed_Uncheck"
                                                    Margin="0,0,2,0">
                                                <TextBlock Text="&#x21BA;" FontSize="15"
                                                           Foreground="#A78BFA"/>
                                            </Button>
                                            <Button Theme="{StaticResource IconButton}"
                                                    ToolTip.Tip="Update time spent"
                                                    Click="CompletedUpdateTime_Click"
                                                    Margin="0,0,2,0">
                                                <TextBlock Text="⏱" FontSize="14"
                                                           Foreground="#60A5FA"/>
                                            </Button>
                                            <Button Theme="{StaticResource IconButton}"
                                                    ToolTip.Tip="Delete"
                                                    Click="CompletedDelete_Click">
                                                <TextBlock Text="&#x1F5D1;" FontSize="14"
                                                           Foreground="#F87171"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- PAGE 3: Notes -->
            <Grid x:Name="NotesPage" IsVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Add note panel -->
                <Border x:Name="AddNotePanel" Grid.Row="0"
                        IsVisible="False"
                        Background="{DynamicResource HeaderBackground}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                        Padding="14,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0" x:Name="NoteTitleBox" Theme="{StaticResource InputBox}"
                                 Watermark="Note title..." Text="{Binding NewNoteTitle}"/>
                        <TextBox Grid.Row="2" x:Name="NoteDescBox" Theme="{StaticResource InputBox}"
                                 Watermark="Note content (optional)..."
                                 Text="{Binding NewNoteDescription}"
                                 MinHeight="60" MaxHeight="120" TextWrapping="Wrap"
                                 AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"/>
                        <TextBox Grid.Row="4" x:Name="NoteTagsBox" Theme="{StaticResource InputBox}"
                                 Watermark="Search terms / tags (comma-separated)..."/>
                        <!-- Attachments: saved with the note when it is added -->
                        <ctrl:PendingAttachmentsPanel x:Name="NewNoteAttachments" Grid.Row="6"/>
                        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Theme="{StaticResource SecondaryButton}"
                                    Content="Cancel" Margin="0,0,8,0"
                                    Click="CancelNote_Click"/>
                            <Button Theme="{StaticResource PrimaryButton}"
                                    Content="Add Note" Click="SaveNote_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Search -->
                <Border Grid.Row="1" Padding="14,8"
                        Background="{DynamicResource HeaderBackground}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                    <TextBox Theme="{StaticResource InputBox}" Watermark="Search notes..."
                             Text="{Binding NoteSearch}"/>
                </Border>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="14,10">
                    <StackPanel>
                        <TextBlock x:Name="NotesEmptyLabel" Text="No notes yet."
                                   Theme="{StaticResource SubText}"
                                   HorizontalAlignment="Center" Margin="0,24,0,0"
                                   IsVisible="False"/>
                        <ItemsControl x:Name="NotesList" ItemsSource="{Binding FilteredNotes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:Note">
                                    <Border Theme="{StaticResource TaskCard}" Margin="0,0,0,8"
                                            Cursor="Hand" PointerReleased="Note_Click">
                                        <Grid Margin="12,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3"/>
                                                <TextBlock x:Name="NoteDescriptionText"
                                                           Text="{Binding Description}" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           TextTrimming="CharacterEllipsis" MaxHeight="36"
                                                           beh:TextOverflow.Detect="True"/>
                                                <!-- "There's more": open the note to read all of it -->
                                                <TextBlock Text="&#x22EF;" FontSize="16" FontWeight="Bold" LineHeight="14"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           ToolTip.Tip="Open the note to see all of it"
                                                           IsVisible="{Binding #NoteDescriptionText.(beh:TextOverflow.IsTrimmed)}"/>
                                                <!-- Tag chips (only rendered when there are tags) -->
                                                <ItemsControl ItemsSource="{Binding TagList}" Margin="0,5,0,0"
                                                              IsVisible="{Binding Tags, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#1A3A5C" BorderBrush="#3B82F6"
                                                                    BorderThickness="1" CornerRadius="10"
                                                                    Padding="7,2" Margin="0,0,4,0">
                                                                <TextBlock Text="{Binding}" FontSize="10"
                                                                           Foreground="#60A5FA"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <!-- Attachment count (only when the note has files) -->
                                                <TextBlock IsVisible="{Binding HasAttachments}"
                                                           FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                                           Margin="0,5,0,0">
                                                    <Run Text="&#x1F4CE; "/>
                                                    <Run Text="{Binding AttachmentCountDisplay, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Theme="{StaticResource IconButton}"
                                                    VerticalAlignment="Center" Click="DeleteNote_Click">
                                                <TextBlock Text="&#x1F5D1;" FontSize="14" Foreground="#F87171"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- PAGE 4: Stats -->
            <Grid x:Name="StatsPage" IsVisible="False">
                <ScrollViewer x:Name="StatsScrollViewer" VerticalScrollBarVisibility="Auto" Padding="14,12">
                    <StackPanel>
                        <!-- Summary cards row -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Theme="{StaticResource TaskCard}" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="TODAY" Theme="{StaticResource LabelText}"/>
                                    <TextBlock x:Name="StatTodayCount" FontSize="24" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryBlue}" Text="0"/>
                                    <TextBlock Text="completed" Theme="{StaticResource SubText}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Theme="{StaticResource TaskCard}" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="THIS WEEK" Theme="{StaticResource LabelText}"/>
                                    <TextBlock x:Name="StatWeekCount" FontSize="24" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentGreen}" Text="0"/>
                                    <TextBlock Text="completed" Theme="{StaticResource SubText}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Theme="{StaticResource TaskCard}" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="TODAY TIME" Theme="{StaticResource LabelText}"/>
                                    <TextBlock x:Name="StatTimeToday" FontSize="18" FontWeight="Bold"
                                               Foreground="#FB923C" FontFamily="{StaticResource MonoFont}" Text="0m"/>
                                    <TextBlock Text="tracked" Theme="{StaticResource SubText}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="6" Theme="{StaticResource TaskCard}" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="ALL TIME" Theme="{StaticResource LabelText}"/>
                                    <TextBlock x:Name="StatAllTime" FontSize="18" FontWeight="Bold"
                                               Foreground="#A78BFA" FontFamily="{StaticResource MonoFont}" Text="0m"/>
                                    <TextBlock Text="tracked" Theme="{StaticResource SubText}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Meeting Hours (auto-detected: meeting app + mic/camera) -->
                        <Border x:Name="MeetingHoursCard" Theme="{StaticResource TaskCard}" Padding="14,12" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Meeting Hours" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <RadioButton x:Name="MeetingFilterToday" GroupName="MeetingFilter"
                                                     Theme="{StaticResource FilterChip}" Content="Today"
                                                     Tag="today" Click="MeetingFilter_Click" Margin="0,0,4,0"/>
                                        <RadioButton x:Name="MeetingFilterWeek" GroupName="MeetingFilter"
                                                     Theme="{StaticResource FilterChip}" Content="This Week"
                                                     Tag="week" IsChecked="True"
                                                     Click="MeetingFilter_Click" Margin="0,0,4,0"/>
                                        <RadioButton x:Name="MeetingFilterMonth" GroupName="MeetingFilter"
                                                     Theme="{StaticResource FilterChip}" Content="This Month"
                                                     Tag="month" Click="MeetingFilter_Click"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="StatMeetingDisplay"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="#34D399" FontFamily="{StaticResource MonoFont}" Text="—"/>
                                <TextBlock Text="meeting app + mic/camera detected"
                                           Theme="{StaticResource SubText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Last 7 Days — task count + time spent, with week navigation -->
                        <Border Theme="{StaticResource TaskCard}" Padding="14,12" Margin="0,0,0,16">
                            <StackPanel>
                                <!-- Header with week navigation -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Last 7 Days" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="PrevWeekBtn" Theme="{StaticResource IconButton}"
                                                Click="PrevWeek_Click" ToolTip.Tip="Previous week">
                                            <TextBlock Text="&#x2190;" FontSize="13"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                        </Button>
                                        <TextBlock x:Name="WeekLabel" Text="" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" Margin="4,0"/>
                                        <Button x:Name="NextWeekBtn" Theme="{StaticResource IconButton}"
                                                Click="NextWeek_Click" ToolTip.Tip="Next week" IsEnabled="False">
                                            <TextBlock Text="&#x2192;" FontSize="13"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <!-- Two charts side by side -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Tasks completed" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <StackPanel x:Name="BarChartPanel" Orientation="Horizontal"
                                                    VerticalAlignment="Bottom" MinHeight="80"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Time spent" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <StackPanel x:Name="TimeChartPanel" Orientation="Horizontal"
                                                    VerticalAlignment="Bottom" MinHeight="80"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Top tasks -->
                        <Border Theme="{StaticResource TaskCard}" Padding="14,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Most Time Spent" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <RadioButton x:Name="TopToday"   GroupName="TopFilter"
                                                     Theme="{StaticResource FilterChip}" Content="Today"
                                                     Tag="today"   Margin="0,0,4,0" Click="TopFilter_Click"/>
                                        <RadioButton x:Name="TopWeek"    GroupName="TopFilter"
                                                     Theme="{StaticResource FilterChip}" Content="Week"
                                                     Tag="week"    Margin="0,0,4,0" Click="TopFilter_Click"/>
                                        <RadioButton x:Name="TopMonth"   GroupName="TopFilter"
                                                     Theme="{StaticResource FilterChip}" Content="Month"
                                                     Tag="month"   Margin="0,0,4,0" Click="TopFilter_Click"/>
                                        <RadioButton x:Name="TopOverall" GroupName="TopFilter"
                                                     Theme="{StaticResource FilterChip}" Content="Overall"
                                                     Tag="overall" IsChecked="True" Click="TopFilter_Click"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="TopTasksPanel"/>
                                <TextBlock x:Name="TopTasksEmpty"
                                           Text="No tracked time yet."
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,4" IsVisible="False"/>
                            </StackPanel>
                        </Border>

                        <!-- Busiest Hour -->
                        <Border Theme="{StaticResource TaskCard}" Padding="14,12" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Busiest Hour" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Avg completions per active day  ·  7 AM – 9 PM  ·  last 30 days"
                                           FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,2,0,10"/>
                                <StackPanel x:Name="BusiestHourPanel" Orientation="Horizontal"
                                            VerticalAlignment="Bottom"/>
                                <TextBlock x:Name="BusiestHourEmpty"
                                           Text="No completion data yet."
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,4" IsVisible="False"/>
                            </StackPanel>
                        </Border>

                        <!-- Weekly Summary (time or task count toggle) -->
                        <Border Theme="{StaticResource TaskCard}" Padding="14,12" Margin="0,16,0,0">
                            <StackPanel>
                                <!-- Header with Time / Tasks toggle -->
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Weekly Summary" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="WeeklyTimeToggle" GroupName="WeeklyMode"
                                                     Theme="{StaticResource FilterChip}" Content="Time"
                                                     IsChecked="True" Click="WeeklyToggle_Click" Margin="0,0,4,0"/>
                                        <RadioButton x:Name="WeeklyTaskToggle" GroupName="WeeklyMode"
                                                     Theme="{StaticResource FilterChip}" Content="Tasks"
                                                     Click="WeeklyToggle_Click"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Avg per active month  ·  last 12 months  ·  W1 = days 1–7,  W4 = days 22–end"
                                           FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,2,0,10"/>
                                <ScrollViewer x:Name="WeeklyChartScroll"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="WeeklyChartPanel" Orientation="Horizontal"
                                                VerticalAlignment="Bottom"/>
                                </ScrollViewer>
                                <TextBlock x:Name="WeeklyChartEmpty"
                                           Text="No tracked time yet."
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,4" IsVisible="False"/>
                            </StackPanel>
                        </Border>

                        <!-- App Usage -->
                        <Border Theme="{StaticResource TaskCard}" Padding="14,12" Margin="0,16,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="App Usage" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock x:Name="AppUsageSubtitle"
                                                   Text="Time spent in each Windows application  ·  top 10"
                                                   FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <RadioButton x:Name="AppUsageToday" GroupName="AppUsageFilter"
                                                     Theme="{StaticResource FilterChip}" Content="Today"
                                                     IsChecked="True" Tag="today"
                                                     Click="AppUsageFilter_Click" Margin="0,0,4,0"/>
                                        <RadioButton x:Name="AppUsageWeek" GroupName="AppUsageFilter"
                                                     Theme="{StaticResource FilterChip}" Content="This Week"
                                                     Tag="week" Click="AppUsageFilter_Click" Margin="0,0,4,0"/>
                                        <RadioButton x:Name="AppUsageMonth" GroupName="AppUsageFilter"
                                                     Theme="{StaticResource FilterChip}" Content="Month"
                                                     Tag="month" Click="AppUsageFilter_Click" Margin="0,0,8,0"/>
                                        <Button Click="AppUsageRefresh_Click"
                                                Theme="{StaticResource IconButton}"
                                                ToolTip.Tip="Refresh app usage"
                                                Width="26" Height="26" Padding="0">
                                            <TextBlock Text="&#x21BB;" FontSize="13"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="AppUsagePanel"/>
                                <TextBlock x:Name="AppUsageEmpty"
                                           Text="No app usage data yet — start using apps and check back."
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap" Margin="0,4" IsVisible="False"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- PAGE 5: Notifications & Reminders -->
            <Grid x:Name="RemindersPage" IsVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Full-width segmented tab bar -->
                <Grid Grid.Row="0" Background="{DynamicResource HeaderBackground}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="NotifTabBtn" Grid.Column="0"
                                 GroupName="ReminderTabs" IsChecked="True"
                                 Theme="{StaticResource ReminderTab}"
                                 HorizontalAlignment="Stretch"
                                 Tag="&#x1F514;" Content="Notifications"
                                 Click="NotifTab_Click"/>
                    <RadioButton x:Name="UpcomingTabBtn" Grid.Column="1"
                                 GroupName="ReminderTabs"
                                 Theme="{StaticResource ReminderTab}"
                                 HorizontalAlignment="Stretch"
                                 Tag="&#x23F0;" Content="Upcoming Reminders"
                                 Click="UpcomingTab_Click"/>
                    <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="1"
                            Background="{DynamicResource BorderColor}"/>
                </Grid>

                <!-- TAB 1: Notifications -->
                <ScrollViewer x:Name="NotifPanel" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto" Padding="14,12">
                    <StackPanel>
                        <!-- NEW (unread) -->
                        <StackPanel x:Name="MissedSection" IsVisible="False" Margin="0,0,0,8">
                            <TextBlock Text="NEW" FontSize="10" FontWeight="Bold"
                                       Foreground="#EF4444" Margin="0,0,0,6"/>
                            <ItemsControl x:Name="MissedList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" CornerRadius="8"
                                                Cursor="Hand" PointerReleased="MissedNotif_Click"
                                                Background="#1E3A5F" BorderBrush="#60A5FA"
                                                BorderThickness="0,0,0,2" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <Border Background="{DynamicResource TagBackground}"
                                                                CornerRadius="3" Padding="5,1" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding TaskIdDisplay}"
                                                                       FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TagForeground}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding TaskTitle}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock FontSize="11" Foreground="#93C5FD">
                                                        <Run Text="&#x23F0;  "/>
                                                        <Run Text="{Binding FiredAtDisplay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- SEEN (read) -->
                        <StackPanel x:Name="ReadSection" IsVisible="False">
                            <TextBlock Text="SEEN" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,0,0,6" Opacity="0.7"/>
                            <ItemsControl x:Name="ReadList" Opacity="0.65">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" CornerRadius="8"
                                                Cursor="Hand" PointerReleased="ReadNotif_Click"
                                                Background="{DynamicResource AppBackground}"
                                                BorderBrush="{DynamicResource BorderColor}"
                                                BorderThickness="1" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <Border Background="{DynamicResource TagBackground}"
                                                                CornerRadius="3" Padding="5,1" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding TaskIdDisplay}"
                                                                       FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TagForeground}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding TaskTitle}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock FontSize="11"
                                                               Foreground="{DynamicResource TextSecondary}">
                                                        <Run Text="&#x23F0;  "/>
                                                        <Run Text="{Binding FiredAtDisplay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1" Theme="{StaticResource IconButton}"
                                                        ToolTip.Tip="Delete" VerticalAlignment="Center"
                                                        Tag="{Binding Id}" Click="DismissMissedNotif_Click">
                                                    <TextBlock Text="&#x1F5D1;" FontSize="13" Foreground="#F87171"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock x:Name="NotifEmptyLabel" Text="No notifications yet."
                                   Theme="{StaticResource SubText}"
                                   HorizontalAlignment="Center" Margin="0,32,0,0"
                                   IsVisible="False"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 2: Upcoming Reminders -->
                <ScrollViewer x:Name="UpcomingPanel" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto" Padding="14,12"
                              IsVisible="False">
                    <StackPanel>
                        <ItemsControl x:Name="RemindersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Theme="{StaticResource TaskCard}" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="12,10,0,10">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Border Background="{DynamicResource TagBackground}"
                                                            CornerRadius="3" Padding="5,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding TaskIdDisplay}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TagForeground}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding TaskTitle}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#x23F0; " FontSize="11"
                                                               Foreground="#FB923C" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FireDisplay}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="#FB923C" Margin="0,0,10,0"
                                                               VerticalAlignment="Center"/>
                                                    <Border Background="{DynamicResource TagBackground}"
                                                            CornerRadius="3" Padding="5,2">
                                                        <TextBlock Text="{Binding FrequencyDisplay}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondary}"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Theme="{StaticResource IconButton}"
                                                    ToolTip.Tip="Delete reminder" VerticalAlignment="Center"
                                                    Margin="0,0,8,0"
                                                    Tag="{Binding Id}" Click="DeleteReminder_Click">
                                                <TextBlock Text="&#x1F5D1;" FontSize="14" Foreground="#F87171"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="RemindersEmptyLabel"
                                   Text="No upcoming reminders scheduled."
                                   Theme="{StaticResource SubText}"
                                   HorizontalAlignment="Center" Margin="0,32,0,0"
                                   IsVisible="False"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ── PAGE: Settings ──────────────────────────────────────── -->
            <Grid x:Name="SettingsPage" IsVisible="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,16,20,16">

                    <!-- ROW 1: Profile + Appearance side by side — equal height via Grid stretch -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Labels -->
                        <TextBlock Grid.Column="0" Grid.Row="0"
                                   Text="PROFILE" Theme="{StaticResource LabelText}" Margin="0,0,0,6"/>
                        <TextBlock Grid.Column="2" Grid.Row="0"
                                   Text="APPEARANCE" Theme="{StaticResource LabelText}" Margin="0,0,0,6"/>

                        <!-- Profile card -->
                        <Border Grid.Column="0" Grid.Row="1"
                                Theme="{StaticResource TaskCard}" Padding="14,12"
                                VerticalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="Name" FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                                <TextBox x:Name="SettingUserName" Theme="{StaticResource InputBox}"
                                         Watermark="e.g. Muhammad Aadil"
                                         TextChanged="SettingUserName_Changed"/>
                            </StackPanel>
                        </Border>

                        <!-- Appearance card — VerticalAlignment=Stretch matches Profile height -->
                        <Border Grid.Column="2" Grid.Row="1"
                                Theme="{StaticResource TaskCard}" Padding="14,12"
                                VerticalAlignment="Stretch">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Theme" FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ThemeDark"  GroupName="ThemeSetting"
                                                 Theme="{StaticResource FilterChip}" Content="🌙  Dark"
                                                 Margin="0,0,6,0" Click="ThemeSetting_Click" Tag="dark"/>
                                    <RadioButton x:Name="ThemeLight" GroupName="ThemeSetting"
                                                 Theme="{StaticResource FilterChip}" Content="☀️  Light"
                                                 Margin="0,0,6,0" Click="ThemeSetting_Click" Tag="light"/>
                                    <RadioButton x:Name="ThemeAuto"  GroupName="ThemeSetting"
                                                 Theme="{StaticResource FilterChip}" Content="⚡  Auto"
                                                 Click="ThemeSetting_Click" Tag="auto"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ROW 2: Reminder Notifications — full width, stacked rows -->
                    <TextBlock Text="REMINDER NOTIFICATIONS" Theme="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <Border Theme="{StaticResource TaskCard}" Padding="14,14" Margin="0,0,0,14">
                        <StackPanel>

                            <!-- Alert sound -->
                            <TextBlock Text="Alert sound" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>
                                <!-- Items come from the OS sound list (filled in code) -->
                                <ComboBox Grid.Column="0" x:Name="SettingTune"
                                          Theme="{StaticResource ThemedComboBox}"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="SettingTune_Changed"/>
                                <Button Grid.Column="2" Theme="{StaticResource SecondaryButton}"
                                        Padding="0" Height="32" Width="32"
                                        ToolTip.Tip="Preview sound" Click="PreviewTune_Click">
                                    <TextBlock Text="&#x25B6;" FontSize="11" Foreground="#60A5FA"/>
                                </Button>
                            </Grid>

                            <!-- Accent color -->
                            <TextBlock Text="Accent color" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton x:Name="AccentBlue"   GroupName="AccentColor"
                                             Theme="{StaticResource FilterChip}" Content="Blue"
                                             Tag="#60A5FA" Margin="0,0,6,0" Click="AccentColor_Click"/>
                                <RadioButton x:Name="AccentGreen"  GroupName="AccentColor"
                                             Theme="{StaticResource FilterChip}" Content="Green"
                                             Tag="#22C55E" Margin="0,0,6,0" Click="AccentColor_Click"/>
                                <RadioButton x:Name="AccentOrange" GroupName="AccentColor"
                                             Theme="{StaticResource FilterChip}" Content="Orange"
                                             Tag="#FB923C" Margin="0,0,6,0" Click="AccentColor_Click"/>
                                <RadioButton x:Name="AccentPurple" GroupName="AccentColor"
                                             Theme="{StaticResource FilterChip}" Content="Purple"
                                             Tag="#A78BFA" Click="AccentColor_Click"/>
                            </StackPanel>

                            <!-- Auto-dismiss -->
                            <TextBlock Text="Auto-dismiss" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton x:Name="DismissPerm" GroupName="DismissTime"
                                             Theme="{StaticResource FilterChip}" Content="Permanent"
                                             Tag="0" Margin="0,0,6,0" Click="DismissTime_Click"/>
                                <RadioButton x:Name="Dismiss15"   GroupName="DismissTime"
                                             Theme="{StaticResource FilterChip}" Content="15 s"
                                             Tag="15" Margin="0,0,6,0" Click="DismissTime_Click"/>
                                <RadioButton x:Name="Dismiss30"   GroupName="DismissTime"
                                             Theme="{StaticResource FilterChip}" Content="30 s"
                                             Tag="30" Margin="0,0,6,0" Click="DismissTime_Click"/>
                                <RadioButton x:Name="Dismiss60"   GroupName="DismissTime"
                                             Theme="{StaticResource FilterChip}" Content="60 s"
                                             Tag="60" Click="DismissTime_Click"/>
                            </StackPanel>

                            <!-- Test notification -->
                            <TextBlock Text="Test notification" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <Button x:Name="TestNotifBtn" Click="TestNotification_Click"
                                    Theme="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left" Padding="14,7"
                                    ToolTip.Tip="Fire a real reminder to verify your settings">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x1F514;" FontSize="13" Margin="0,0,7,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Send test notification" FontSize="12"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </Border>

                    <!-- ROW 3: Task Completion -->
                    <TextBlock Text="TASK COMPLETION" Theme="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <Border Theme="{StaticResource TaskCard}" Padding="14,12" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Show completion popup"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Celebration dialog with confetti when a task is marked done"
                                           Theme="{StaticResource SubText}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          x:Name="CompletionPopupToggle"
                                          Theme="{StaticResource ActiveToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Click="CompletionPopupToggle_Click"/>
                        </Grid>
                    </Border>
                    <Border Theme="{StaticResource TaskCard}" Padding="14,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Save screenshot to Desktop"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="When off, the banner is only copied to clipboard"
                                           Theme="{StaticResource SubText}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          x:Name="SaveScreenshotToggle"
                                          Theme="{StaticResource ActiveToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Click="SaveScreenshotToggle_Click"/>
                        </Grid>
                    </Border>

                    <!-- ROW 5: Data / Recycle Bin + Meeting History -->
                    <TextBlock Text="DATA" Theme="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <Button Click="OpenTrash_Click" Theme="{StaticResource RecycleBinCardButton}"/>

                    <!-- Clear meeting history -->
                    <Border x:Name="MeetingHistoryCard" Theme="{StaticResource TaskCard}" Padding="14,11" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#x1F4F9;" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Meeting History" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Clear all auto-detected meeting sessions"
                                           Theme="{StaticResource SubText}" Margin="0,1,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="ClearMeetingHistoryBtn"
                                    Theme="{StaticResource SecondaryButton}"
                                    Padding="12,6" Click="ClearMeetingHistory_Click"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Clear" FontSize="12"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Migrate to another computer (encrypted export / import) -->
                    <Border Theme="{StaticResource TaskCard}" Padding="14,11" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#x1F4BB;" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Migrate to another computer" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="MigrateSubtitle"
                                           Text="Export everything to one password-protected file, or import it on a new PC"
                                           Theme="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Theme="{StaticResource PrimaryButton}"
                                    Padding="12,6" Click="Migrate_Click"
                                    VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="Open" FontSize="12"/>
                            </Button>
                        </Grid>
                    </Border>

                </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- PAGE: Recycle Bin -->
            <Grid x:Name="TrashPage" IsVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Info banner -->
                <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                        Padding="14,10">
                    <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="12"
                               TextWrapping="Wrap"
                               Text="Deleted tasks are kept here for 30 days, then removed automatically. Restore puts a task back in its list."/>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,10">
                    <Grid>
                        <!-- Empty state -->
                        <StackPanel x:Name="TrashEmptyState" VerticalAlignment="Center"
                                    HorizontalAlignment="Center" Margin="0,60,0,0">
                            <TextBlock Text="&#x1F5D1;" FontSize="40" HorizontalAlignment="Center"
                                       Opacity="0.5" Margin="0,0,0,10"/>
                            <TextBlock Text="The recycle bin is empty"
                                       Foreground="{DynamicResource TextSecondary}" FontSize="14"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl x:Name="TrashList" ItemsSource="{Binding DeletedTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:TaskItemViewModel">
                                    <Border Theme="{StaticResource TaskCard}" Margin="0,0,0,8">
                                        <Grid Margin="12,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Border Background="{DynamicResource TagBackground}"
                                                            CornerRadius="3" Padding="5,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding TaskNumberDisplay}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TagForeground}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DeletedAtDisplay}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Theme="{StaticResource IconButton}"
                                                        ToolTip.Tip="Restore" Click="Restore_Click" Margin="0,0,4,0">
                                                    <TextBlock Text="&#x21BA;" FontSize="15" Foreground="#22C55E"/>
                                                </Button>
                                                <Button Theme="{StaticResource IconButton}"
                                                        ToolTip.Tip="Delete permanently" Click="PermanentDelete_Click">
                                                    <TextBlock Text="&#x1F5D1;" FontSize="14" Foreground="#F87171"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Grid>

        </Grid><!-- end page container -->


        <!-- Dim + blur overlay for modal dialogs -->
        <Border x:Name="DimOverlay" Grid.Row="0" Grid.RowSpan="3"
                Background="#AA000000"
                IsVisible="False"
                ZIndex="997"/>

        <!-- ═══ In-app notification overlay (bottom-right inside window) ═══ -->
        <Border x:Name="InAppNotifBorder" Grid.Row="0" Grid.RowSpan="3"
                VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Margin="0,0,16,16"
                IsVisible="False"
                IsHitTestVisible="False"
                ZIndex="999">
            <Border x:Name="NotifMainBorder"
                    Background="#1F2937"
                    CornerRadius="10" Padding="0"
                    MinWidth="280" MaxWidth="380">
                <Border.Effect>
                    <DropShadowDirectionEffect BlurRadius="18" ShadowDepth="4" Opacity="0.3" Color="#000"/>
                </Border.Effect>
                <Grid>
                    <Border x:Name="NotifAccent" Width="4" HorizontalAlignment="Left"
                            CornerRadius="10,0,0,10" Background="#22C55E"/>
                    <StackPanel Orientation="Horizontal" Margin="16,12,16,12">
                        <TextBlock x:Name="NotifIcon" FontSize="16"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="NotifMessage"
                                   Foreground="White" FontSize="12"
                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                   MaxWidth="300"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Confetti canvas -->
        <Canvas x:Name="ConfettiLayer" Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False"
                ZIndex="1000"/>

    </Grid>
</Window>
