<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- One cross-platform build: Avalonia UI runs the same app on Windows and macOS.
         Windows-only and macOS-only features live under Platform/ and are chosen at runtime. -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Tasky</RootNamespace>
    <AssemblyName>Tasky</AssemblyName>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Optimize>true</Optimize>
    <!-- Embed runtime so publish = single folder, no separate install needed -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifiers>win-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <PublishSingleFile>false</PublishSingleFile>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <!-- SQLite for local persistence -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <!-- Windows: lock / sleep / theme-change notifications -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
    <!-- Windows: extracting app icons for the App Usage panel -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\icon.ico" />
    <AvaloniaResource Include="Assets\tasky-logo.png" />
    <!-- macOS emoji icons: single-colour Noto Emoji (SIL Open Font License, see OFL-NotoEmoji.txt) -->
    <AvaloniaResource Include="Assets\Fonts\NotoEmoji-Variable.ttf" />
    <None Include="Assets\Fonts\OFL-NotoEmoji.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\notification-banner.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="app.manifest" />
  </ItemGroup>

</Project>
