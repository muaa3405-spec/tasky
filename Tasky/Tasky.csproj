<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004+ TFM enables WinRT APIs for toast notifications -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms needed for NotifyIcon (system tray) -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Tasky</RootNamespace>
    <AssemblyName>Tasky</AssemblyName>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <!-- Embed runtime so publish = single folder, no separate install needed -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>false</PublishSingleFile>
    <Optimize>true</Optimize>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQLite for local persistence -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <!-- Windows Community Toolkit – Win32 toast notification helper -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- MSAL – Microsoft identity / OAuth2 for Teams/Graph calendar -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.66.2" />
    <!-- DPAPI – encrypts the saved sign-in token for the current Windows user -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Icons embedded as WPF resources -->
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\tasky-logo.png" />
    <!-- Notification banner must be a loose file (not embedded) so the
         Windows notification system can load it by absolute file:// path -->
    <Content Include="Assets\notification-banner.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="app.manifest" />
  </ItemGroup>

</Project>
