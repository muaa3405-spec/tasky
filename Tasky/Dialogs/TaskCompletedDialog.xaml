<Window x:Class="Tasky.Dialogs.TaskCompletedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Tasky.Controls"
        Title="Task Completed"
        Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseDown">

    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid>
    <!-- Main card -->
    <Border x:Name="CardRoot" CornerRadius="16" Opacity="0"
            Background="#0F172A"
            BorderBrush="#1E293B" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <!-- Confetti canvas overlaid on top section -->
            <ctrl:ConfettiCanvas x:Name="ConfettiLayer"
                                 Height="160" VerticalAlignment="Top"
                                 IsHitTestVisible="False" Panel.ZIndex="10"/>

            <StackPanel Margin="0,0,0,0">

                <!-- ── Celebration header ──────────────────────────────── -->
                <Border Background="#1E293B" CornerRadius="16,16,0,0" Padding="24,20,24,18">
                    <StackPanel>
                        <!-- Logo + App name -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Margin="0,0,0,16">
                            <Image Source="pack://application:,,,/Assets/tasky-logo.png"
                                   Width="24" Height="24"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Tasky" FontSize="15" FontWeight="SemiBold"
                                       Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Big celebration text -->
                        <TextBlock Text="🎉  Task Completed!"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="SubtitleLabel"
                                   FontSize="12" Foreground="#64748B"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ── Task details card ──────────────────────────────── -->
                <Border Margin="20,16,20,0" Background="#1E293B"
                        BorderBrush="#334155" BorderThickness="1"
                        CornerRadius="10" Padding="18,14">
                    <StackPanel>
                        <!-- Task number badge -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#0EA5E9" CornerRadius="4" Padding="6,2">
                                <TextBlock x:Name="TaskNumberLabel"
                                           FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <!-- Group badge if any -->
                            <Border x:Name="GroupBadge" CornerRadius="4" Padding="6,2"
                                    Margin="6,0,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="GroupLabel"
                                           FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>

                        <!-- Title -->
                        <TextBlock x:Name="TitleLabel"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="White" TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <!-- Description — capped so a long one scrolls instead of
                             pushing the Continue button off screen -->
                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="DescLabel"
                                       FontSize="12" Foreground="#94A3B8"
                                       TextWrapping="Wrap" Margin="0,0,0,12"
                                       Visibility="Collapsed"/>
                        </ScrollViewer>

                        <!-- Completed date only -->
                        <StackPanel>
                            <TextBlock Text="COMPLETED" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#475569" Margin="0,0,0,2"/>
                            <TextBlock x:Name="DateLabel"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="#60A5FA"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Action buttons ─────────────────────────────────── -->
                <StackPanel x:Name="ActionButtons" Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="20,16,20,20">
                    <Button x:Name="ScreenshotBtn"
                            Click="Screenshot_Click"
                            Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#1E3A5F"
                                        BorderBrush="#0EA5E9" BorderThickness="1"
                                        CornerRadius="8" Padding="16,10" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📸" FontSize="14" Margin="0,0,6,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Take Screenshot" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="#0EA5E9"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1E4A6F"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Click="Close_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#22C55E"
                                        CornerRadius="8" Padding="16,10" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✓" FontSize="14" FontWeight="Bold"
                                                   Foreground="White" Margin="0,0,6,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Continue" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="White"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#16A34A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

            </StackPanel>
        </Grid>
    </Border>

    <!-- Banner capture target — hidden, rendered only for screenshot.
         Auto-sizes to its content so the saved image is a tight, small banner. -->
    <Border x:Name="BannerCapture" Visibility="Collapsed"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Padding="22,16"
            Background="#0F172A"
            BorderBrush="#1E293B" BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Left: green check -->
            <Border Grid.Column="0" Width="56" Height="56" CornerRadius="28"
                    Background="#052E16" BorderBrush="#22C55E" BorderThickness="2"
                    VerticalAlignment="Center" Margin="0,0,20,0">
                <TextBlock Text="&#x2713;" FontSize="26" FontWeight="Bold" Foreground="#22C55E"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <!-- Centre: task info -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,28,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <Border Background="#0EA5E9" CornerRadius="4" Padding="7,2" Margin="0,0,8,0">
                        <TextBlock x:Name="BannerTaskNum" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <Border Background="#166534" CornerRadius="10" Padding="10,2">
                        <TextBlock Text="&#x2713;  Completed" FontSize="11" FontWeight="SemiBold" Foreground="#4ADE80"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="BannerTitle" FontSize="18" FontWeight="Bold"
                           Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                <TextBlock x:Name="BannerDate" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>
            <!-- Right: branding -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Image Source="pack://application:,,,/Assets/tasky-logo.png"
                       Width="28" Height="28" HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,4"/>
                <TextBlock Text="Tasky" FontSize="12" FontWeight="SemiBold"
                           Foreground="#475569" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>

    </Grid>
</Window>
