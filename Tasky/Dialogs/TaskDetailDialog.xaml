<Window x:Class="Tasky.Dialogs.TaskDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Detail — Tasky"
        Width="560" SizeToContent="Height"
        Background="{DynamicResource AppBackground}"
        WindowStyle="ToolWindow" ResizeMode="CanResize"
        ShowInTaskbar="False"
        Opacity="0"
        ContentRendered="Window_ContentRendered">

    <Border Style="{StaticResource DialogFrame}">
    <!-- Wrapper gives us a RenderTransform target independent of the Window itself -->
    <Grid x:Name="DialogRoot">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" Y="18"/>
        </Grid.RenderTransform>
        <!-- Content scrolls; footer stays pinned at the bottom -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,20,24,8">
        <StackPanel>

            <!-- ── Header: ID/Status left · Time+Due right ────────────── -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: task number + status badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource TagBackground}" CornerRadius="4"
                            Padding="8,3" Margin="0,0,8,0">
                        <TextBlock x:Name="TaskNumberLabel" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TagForeground}"/>
                    </Border>
                    <Border x:Name="StatusBadge" CornerRadius="10" Padding="10,3">
                        <TextBlock x:Name="StatusLabel" FontSize="12" FontWeight="SemiBold"
                                   Foreground="White"/>
                    </Border>
                </StackPanel>

                <!-- Right: time tracked + due date stacked -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Time tracked pill -->
                    <Border Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            CornerRadius="6" Padding="10,4" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏱ " FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="TimeLabel"
                                     Style="{StaticResource SelectableText}"
                                     FontFamily="Consolas" FontSize="12"
                                     FontWeight="SemiBold" Foreground="{DynamicResource AccentGreen}"/>
                        </StackPanel>
                    </Border>
                    <!-- Start date pill -->
                    <Border Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            CornerRadius="6" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📅 " FontSize="11" VerticalAlignment="Center"/>
                            <TextBox x:Name="DueLabel"
                                     Style="{StaticResource SelectableText}"
                                     FontSize="12" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ── Title (selectable) ─────────────────────────────────── -->
            <TextBox x:Name="TitleLabel"
                     Style="{StaticResource SelectableText}"
                     FontSize="20" FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimary}"
                     Margin="0,0,0,16"/>

            <!-- ── Description (selectable) ──────────────────────────── -->
            <TextBlock Text="Description" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    CornerRadius="6" Padding="12,10" Margin="0,0,0,20">
                <TextBox x:Name="DescLabel"
                         Style="{StaticResource SelectableText}"
                         Foreground="{DynamicResource TextPrimary}"
                         FontSize="13"/>
            </Border>

            <!-- ── Attachments ────────────────────────────────────────── -->
            <TextBlock x:Name="AttachHeader" Text="Attachments"
                       Style="{StaticResource SubText}" Margin="0,0,0,8"/>
            <WrapPanel x:Name="AttachPanel" Orientation="Horizontal" Margin="0,0,0,20"/>
            <TextBlock x:Name="NoAttachLabel" Text="No attachments."
                       Style="{StaticResource SubText}" Margin="0,0,0,20"/>

            <!-- ── Quick remind ──────────────────────────────────────── -->
            <Border x:Name="QuickRemindCard"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#x1F514;  Remind in"
                               FontSize="13" Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox x:Name="QuickRemindBox" Grid.Column="1"
                              Style="{StaticResource ThemedComboBox}" FontSize="13">
                        <ComboBoxItem Content="5 minutes"  Tag="5"  IsSelected="True"/>
                        <ComboBoxItem Content="10 minutes" Tag="10"/>
                        <ComboBoxItem Content="15 minutes" Tag="15"/>
                        <ComboBoxItem Content="30 minutes" Tag="30"/>
                        <ComboBoxItem Content="45 minutes" Tag="45"/>
                        <ComboBoxItem Content="1 hour"     Tag="60"/>
                    </ComboBox>
                    <Button Grid.Column="2" Content="Set Reminder"
                            Style="{StaticResource PrimaryButton}"
                            Margin="12,0,0,0" FontSize="13"
                            Click="QuickRemind_Click"/>
                </Grid>
            </Border>
            <!-- Shown after reminder is set — hidden by default -->
            <Border x:Name="RemindSetCard"
                    Background="#052E16"
                    BorderBrush="#16A34A" BorderThickness="1"
                    CornerRadius="8" Padding="14,12" Margin="0,0,0,12"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✔" FontSize="15" Foreground="#4ADE80"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="RemindSetLabel" FontSize="13"
                               Foreground="#4ADE80" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

            <!-- ── Footer: created date + close ──────────────────────── -->
            <Grid Grid.Row="1" Margin="24,8,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="CreatedLabel"
                           Style="{StaticResource SubText}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Close"
                        Style="{StaticResource SecondaryButton}"
                        Click="Close_Click"/>
            </Grid>
    </Grid>
    </Border>
</Window>
