<Window x:Class="Tasky.Dialogs.NoteDetailDialog"
        Classes="toolWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="using:Tasky.Controls"
        Title="Note"
        Background="{DynamicResource AppBackground}"
        Width="500" SizeToContent="Height"
        MinHeight="260"
        ShowInTaskbar="False">

    <Border Theme="{StaticResource DialogFrame}">
    <!-- Content scrolls; footer stays pinned at the bottom -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,20,24,0">
    <StackPanel>

        <!-- Title -->
        <TextBlock Text="TITLE" Theme="{StaticResource LabelText}"/>
        <TextBox x:Name="TitleBox" Theme="{StaticResource InputBox}"
                 Watermark="Note title…"
                 Margin="0,0,0,16"
                 TextChanged="Field_Changed"/>

        <!-- Description label + copy icon aligned -->
        <Grid Margin="0,0,0,4">
            <TextBlock Text="DESCRIPTION" Theme="{StaticResource LabelText}"
                       VerticalAlignment="Center"/>
            <!-- Copy icon — top-right of the label row -->
            <Button x:Name="CopyBtn" HorizontalAlignment="Right"
                    Theme="{StaticResource IconButton}"
                    ToolTip.Tip="Copy description to clipboard"
                    Click="CopyDesc_Click" Padding="4">
                <TextBlock Text="📋" FontSize="14"
                           Foreground="{DynamicResource TextSecondary}"/>
            </Button>
        </Grid>

        <!-- Editable description (always open) -->
        <TextBox x:Name="DescBox" Theme="{StaticResource InputBox}"
                 Watermark="Note description…"
                 MinHeight="120" MaxHeight="380"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,20"
                 TextChanged="Field_Changed"/>

        <!-- Tags -->
        <TextBlock Text="SEARCH TERMS / TAGS" Theme="{StaticResource LabelText}" Margin="0,0,0,4"/>
        <TextBox x:Name="TagsBox" Theme="{StaticResource InputBox}"
                 Watermark="Comma-separated tags, e.g. iphone, bluetooth, settings"
                 Margin="0,0,0,20"
                 TextChanged="Field_Changed"/>

        <!-- Attachments — saved immediately, independent of "Save Changes" -->
        <TextBlock Text="ATTACHMENTS" Theme="{StaticResource LabelText}" Margin="0,0,0,4"/>
        <ctrl:AttachmentsPanel x:Name="Attachments" Margin="0,0,0,20"/>

    </StackPanel>
    </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="24,0,24,20">
            <Button Content="Close" Theme="{StaticResource SecondaryButton}"
                    Padding="14,8" Margin="0,0,10,0" Click="Close_Click"/>
            <Button x:Name="SaveBtn" Content="Save Changes"
                    Theme="{StaticResource PrimaryButton}"
                    Padding="18,8" IsEnabled="False"
                    Click="Save_Click"/>
        </StackPanel>

    <!-- Dotted resize grip in the bottom-right corner, as on Windows -->
    <ctrl:ResizeGrip Grid.RowSpan="2"/>
    </Grid>
    </Border>
</Window>
