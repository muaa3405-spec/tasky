<Window x:Class="Tasky.Dialogs.MigrateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Migrate to another computer"
        Background="{DynamicResource AppBackground}"
        Width="480" SizeToContent="Height"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Style="{StaticResource DialogFrame}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
    <Grid>

        <!-- ── Step 1: choose direction ─────────────────────────────────── -->
        <StackPanel x:Name="ChooseStep">
            <TextBlock Text="Migrate to another computer" FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
            <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,18"
                       Text="Move everything to a new PC in one password-protected file: tasks, completed history, groups, notes, reminders, attachments, reports and settings."/>

            <Button Click="ChooseExport_Click" Margin="0,0,0,10" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="8" Padding="16,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📤" FontSize="22" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Export from this computer" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Create an encrypted migration file" Style="{StaticResource SubText}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Click="ChooseImport_Click" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="8" Padding="16,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📥" FontSize="22" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Import on this computer" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Restore everything from a migration file" Style="{StaticResource SubText}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Close" Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- ── Step 2a: export password ─────────────────────────────────── -->
        <StackPanel x:Name="ExportStep" Visibility="Collapsed">
            <TextBlock Text="📤  Export from this computer" FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="INCLUDED" Style="{StaticResource LabelText}"/>
                    <TextBlock x:Name="ExportSummary" TextWrapping="Wrap" FontSize="13"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="…plus your settings, recycle bin, reports history and missed notifications."
                               Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="CREATE A PASSWORD" Style="{StaticResource LabelText}"/>
            <PasswordBox x:Name="ExportPassword" Style="{StaticResource PasswordInput}" Margin="0,0,0,10"
                         PasswordChanged="ExportPassword_Changed"/>
            <TextBlock Text="CONFIRM PASSWORD" Style="{StaticResource LabelText}"/>
            <PasswordBox x:Name="ExportPasswordConfirm" Style="{StaticResource PasswordInput}" Margin="0,0,0,6"
                         PasswordChanged="ExportPassword_Changed"/>
            <TextBlock x:Name="ExportPasswordHint" Style="{StaticResource SubText}" TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <Border Background="#1AF59E0B" BorderBrush="#F59E0B" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                           Text="⚠  Remember this password. The file is encrypted with it and cannot be opened without it — there is no way to recover a forgotten password."/>
            </Border>
            <TextBlock x:Name="ExportError" Foreground="#EF4444" FontSize="12" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,4,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Back" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="Back_Click"/>
                <Button x:Name="ExportButton" Content="Choose where to save…" Style="{StaticResource PrimaryButton}"
                        IsEnabled="False" Click="Export_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- ── Step 2b: import file + password ──────────────────────────── -->
        <StackPanel x:Name="ImportStep" Visibility="Collapsed">
            <TextBlock Text="📥  Import on this computer" FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

            <TextBlock Text="MIGRATION FILE" Style="{StaticResource LabelText}"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="6" Padding="10,8">
                    <TextBlock x:Name="ImportFileLabel" Text="No file selected" TextTrimming="CharacterEllipsis"
                               FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                </Border>
                <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0" Click="BrowseImport_Click"/>
            </Grid>

            <TextBlock Text="PASSWORD" Style="{StaticResource LabelText}"/>
            <PasswordBox x:Name="ImportPassword" Style="{StaticResource PasswordInput}" Margin="0,0,0,6"
                         PasswordChanged="ImportInput_Changed" KeyDown="ImportPassword_KeyDown"/>
            <TextBlock x:Name="ImportError" Foreground="#EF4444" FontSize="12" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,4,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Back" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="Back_Click"/>
                <Button x:Name="UnlockButton" Content="Unlock" Style="{StaticResource PrimaryButton}"
                        IsEnabled="False" Click="Unlock_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- ── Step 3: confirm import ───────────────────────────────────── -->
        <StackPanel x:Name="ConfirmImportStep" Visibility="Collapsed">
            <TextBlock Text="✔  File unlocked" FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock x:Name="ImportCreatedLabel" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="ImportSummary" TextWrapping="Wrap" FontSize="13"
                               Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
            </Border>

            <Border Background="#1AF59E0B" BorderBrush="#F59E0B" BorderThickness="1"
                    CornerRadius="6" Padding="12,8">
                <TextBlock x:Name="ReplaceWarning" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextPrimary}"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="CancelImport_Click"/>
                <Button Content="Import and restart Tasky" Style="{StaticResource PrimaryButton}" Click="ConfirmImport_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- ── Working ───────────────────────────────────────────────────── -->
        <StackPanel x:Name="WorkingStep" Visibility="Collapsed" Margin="0,24">
            <TextBlock x:Name="WorkingLabel" FontSize="14" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>
            <ProgressBar IsIndeterminate="True" Height="4" Foreground="{DynamicResource PrimaryBlue}"
                         Background="{DynamicResource BorderColor}" BorderThickness="0"/>
        </StackPanel>

        <!-- ── Done (export) ────────────────────────────────────────────── -->
        <StackPanel x:Name="DoneStep" Visibility="Collapsed">
            <TextBlock Text="✔  Migration file created" FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
            <TextBlock x:Name="DoneLabel" TextWrapping="Wrap" FontSize="13"
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
            <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap"
                       Text="Copy it to the new computer (USB stick, network drive…), install Tasky there and choose Settings → Migrate to another computer → Import."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Show in folder" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                        Click="ShowInFolder_Click"/>
                <Button Content="Done" Style="{StaticResource PrimaryButton}" Click="Close_Click"/>
            </StackPanel>
        </StackPanel>

    </Grid>
    </ScrollViewer>
    </Border>
</Window>
