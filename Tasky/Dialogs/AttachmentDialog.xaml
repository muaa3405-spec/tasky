<Window x:Class="Tasky.Dialogs.AttachmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Attachments" Width="540" Height="500"
        Background="{DynamicResource AppBackground}"
        WindowStyle="ToolWindow" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        DragLeave="Window_DragLeave">

    <Grid Margin="18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header -->
            <RowDefinition Height="140"/>   <!-- paste/drop zone -->
            <RowDefinition Height="Auto"/>  <!-- saved label -->
            <RowDefinition Height="*"/>     <!-- saved grid -->
            <RowDefinition Height="Auto"/>  <!-- footer buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="HeaderLabel" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- ── Paste / Drop zone ──────────────────────────────────────── -->
        <Border Grid.Row="1" x:Name="DropZone"
                BorderThickness="2" CornerRadius="10"
                Cursor="Hand"
                MouseLeftButtonUp="DropZone_Click">
            <Border.BorderBrush>
                <SolidColorBrush x:Name="DropBorderBrush" Color="#374151"/>
            </Border.BorderBrush>
            <Border.Background>
                <SolidColorBrush x:Name="DropBgBrush" Color="#1F2937"/>
            </Border.Background>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="DropIcon" Text="📋"
                           FontSize="32" HorizontalAlignment="Center"/>
                <TextBlock x:Name="DropTitle"
                           Text="Click, paste (Ctrl+V) or drop images here"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Center" Margin="0,10,0,4"/>
                <TextBlock Text="PNG, JPG, GIF, BMP, WEBP"
                           FontSize="11" Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Saved attachments label -->
        <TextBlock Grid.Row="2" x:Name="SavedLabel"
                   Text="SAVED ATTACHMENTS" Style="{StaticResource LabelText}"
                   Margin="0,14,0,6" Visibility="Collapsed"/>

        <!-- Saved attachments grid -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="AttachPanel" Orientation="Horizontal"/>
        </ScrollViewer>

        <!-- Empty saved state -->
        <TextBlock Grid.Row="3" x:Name="NoAttachLabel"
                   Text="No attachments yet."
                   Style="{StaticResource SubText}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"/>

        <!-- Footer -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    Margin="0,12,0,0" HorizontalAlignment="Right">
            <Button Content="📎 Browse Files" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0" Click="AddFile_Click"/>
            <Button Content="Close" Style="{StaticResource SecondaryButton}"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
