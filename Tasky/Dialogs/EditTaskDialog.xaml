<Window x:Class="Tasky.Dialogs.EditTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Task"
        Background="{DynamicResource AppBackground}"
        Width="440" SizeToContent="Height"
        WindowStyle="ToolWindow"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Border Style="{StaticResource DialogFrame}">
    <!-- Content scrolls; footer stays pinned at the bottom -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,20,24,0">
    <StackPanel>
        <TextBlock Text="Edit Task" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,20"/>

        <TextBlock Text="TITLE" Style="{StaticResource LabelText}"/>
        <TextBox x:Name="TitleBox" Style="{StaticResource InputBox}" Margin="0,0,0,16"
                 Tag="Task title..."/>

        <TextBlock Text="DESCRIPTION" Style="{StaticResource LabelText}"/>
        <!-- VerticalContentAlignment="Top" keeps placeholder at first line for multiline fields -->
        <TextBox x:Name="DescBox" Style="{StaticResource InputBox}"
                 MinHeight="100" MaxHeight="260" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"
                 VerticalContentAlignment="Top"
                 Tag="Description (optional)..."/>

        <TextBlock Text="START DATE" Style="{StaticResource LabelText}"/>
        <DatePicker x:Name="DueDatePicker"
                    Style="{StaticResource ThemedDatePicker}"
                    Margin="0,0,0,16"/>

        <TextBlock Text="GROUP" Style="{StaticResource LabelText}"/>
        <!-- HorizontalContentAlignment="Left" keeps dot+name left-aligned in the picker -->
        <ComboBox x:Name="GroupPicker" Style="{StaticResource ThemedComboBox}"
                  HorizontalContentAlignment="Left"
                  Margin="0,0,0,16"/>

        <TextBlock Text="RECURRENCE" Style="{StaticResource LabelText}"/>
        <ComboBox x:Name="RecurrencePicker" Style="{StaticResource ThemedComboBox}"
                  Margin="0,0,0,24">
            <ComboBoxItem Content="None"    Tag="0" IsSelected="True"/>
            <ComboBoxItem Content="Daily"   Tag="1"/>
            <ComboBoxItem Content="Weekly"  Tag="2"/>
            <ComboBoxItem Content="Monthly" Tag="3"/>
        </ComboBox>

        <TextBlock Text="ATTACHMENTS" Style="{StaticResource LabelText}"/>
        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                CornerRadius="6" Padding="10" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock x:Name="NoAttachLabel" Text="No attachments yet."
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="12" Opacity="0.7"/>
                <WrapPanel x:Name="AttachThumbs"/>
                <Button x:Name="AddAttachBtn" Content="&#x1F4CE;  Add Image"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left" Margin="0,10,0,0"
                        Padding="12,6" FontSize="12"
                        Click="AddAttachment_Click"/>
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="24,0,24,20">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Save Changes" Style="{StaticResource PrimaryButton}"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
    </Border>
</Window>
