<Window x:Class="Tasky.Windows.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tasky Widget" Width="340" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#DD1E293B" CornerRadius="10" Padding="12,8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <!-- No active task message -->
            <StackPanel x:Name="NoActiveText" Orientation="Horizontal"
                        HorizontalAlignment="Center" Visibility="Collapsed">
                <Image Source="pack://application:,,,/Assets/tasky-logo.png"
                       Width="16" Height="16" Margin="0,0,8,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="No active task — use the toggle in Tasky"
                           Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Active task panel -->
            <Grid x:Name="ActivePanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- complete checkbox -->
                    <ColumnDefinition Width="*"/>     <!-- title + timer -->
                    <ColumnDefinition Width="Auto"/>  <!-- pause/resume -->
                    <ColumnDefinition Width="Auto"/>  <!-- open -->
                </Grid.ColumnDefinitions>

                <!-- Green checkmark — same style as main window -->
                <CheckBox Grid.Column="0"
                          Style="{StaticResource CheckmarkBox}"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0" Click="Widget_Complete_Click"/>

                <!-- Title + timer (icon switches between ⏱ and ⏸) -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ActiveTitle"
                               FontSize="13" FontWeight="SemiBold" Foreground="White"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TimerIcon" Text="⏱" FontSize="11"
                                   Foreground="#22C55E" Margin="0,0,4,0"/>
                        <TextBlock x:Name="ActiveTimer"
                                   FontFamily="Consolas" FontSize="11" Foreground="#22C55E"/>
                    </StackPanel>
                </StackPanel>

                <!-- Pause / Resume — ⏸ running, ▶ paused (matches main UI) -->
                <Button Grid.Column="2" x:Name="PauseBtn"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" VerticalAlignment="Center" Margin="8,0,4,0"
                        ToolTip="Pause / Resume timer" Click="PauseResume_Click">
                    <TextBlock x:Name="PauseIcon" Text="⏸" FontSize="16" Foreground="#F59E0B"/>
                </Button>

                <!-- Open main window -->
                <Button Grid.Column="3"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" VerticalAlignment="Center"
                        ToolTip="Open Tasky" Click="Open_Click">
                    <TextBlock Text="⤢" FontSize="16" Foreground="#94A3B8"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
