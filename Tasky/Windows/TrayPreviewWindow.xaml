<Window x:Class="Tasky.Windows.TrayPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="240"
        SizeToContent="Height"
        IsHitTestVisible="True"
        MouseLeave="Window_MouseLeave">

    <Border x:Name="CardBorder"
            Background="#1F2937"
            CornerRadius="10"
            Padding="14,12"
            Margin="4"
            Opacity="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Border.Resources>
            <Storyboard x:Key="FadeIn">
                <DoubleAnimation Storyboard.TargetName="CardBorder"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.2">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <Storyboard x:Key="FadeOut">
                <DoubleAnimation Storyboard.TargetName="CardBorder"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1" To="0" Duration="0:0:0.15">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Border.Resources>
        <StackPanel>
            <!-- Logo + title row -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="✔" FontSize="16" Foreground="#34D399" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Tasky" FontSize="14" FontWeight="SemiBold"
                           Foreground="#F9FAFB" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Active task info -->
            <Border x:Name="ActiveTaskPanel" Background="#111827" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock x:Name="ActiveTaskTitle"
                               Text="No active task"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="#9CA3AF"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="ActiveTaskTimer"
                               FontSize="11" FontFamily="Consolas"
                               Foreground="#34D399" Margin="0,4,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Open button -->
            <Button x:Name="OpenBtn" Content="Open Tasky"
                    Click="OpenBtn_Click"
                    HorizontalAlignment="Stretch"
                    Padding="0,7" Cursor="Hand"
                    FontSize="12" FontFamily="Segoe UI" FontWeight="SemiBold"
                    Foreground="White" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#60A5FA" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsPressed"   Value="True"><Setter Property="Opacity" Value="0.70"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>
