<Window x:Class="Tasky.Windows.CompletedTasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Tasky.ViewModels"
        Title="Completed Tasks — Tasky"
        Width="660" Height="560"
        Background="{DynamicResource AppBackground}"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header + search + group tabs -->
            <RowDefinition Height="*"/>     <!-- task list -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="16,12">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="☑  Completed Tasks"
                               Style="{StaticResource HeadingText}" FontSize="17" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Style="{StaticResource InputBox}"
                             Tag="Search by title or #ID…"
                             Text="{Binding CompletedSearch, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <!-- Group filter chips -->
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ChipAll"   Style="{StaticResource FilterChip}" Content="All"
                                 IsChecked="True" GroupName="CG" Margin="0,0,6,0" Click="Group_Click" Tag="All"/>
                    <RadioButton x:Name="ChipToday" Style="{StaticResource FilterChip}" Content="Today"
                                 GroupName="CG" Margin="0,0,6,0" Click="Group_Click" Tag="Today"/>
                    <RadioButton x:Name="ChipWeek"  Style="{StaticResource FilterChip}" Content="This Week"
                                 GroupName="CG" Click="Group_Click" Tag="This Week"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Grouped scrollable list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
            <ItemsControl x:Name="CompletedList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Each item is either a group header (string) or a TaskItemViewModel -->
                        <ContentControl Content="{Binding}">
                            <ContentControl.Resources>

                                <!-- Group header -->
                                <DataTemplate DataType="{x:Type system:String}"
                                              xmlns:system="clr-namespace:System;assembly=mscorlib">
                                    <TextBlock Text="{Binding}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,12,0,6"/>
                                </DataTemplate>

                                <!-- Task row -->
                                <DataTemplate DataType="{x:Type vm:TaskItemViewModel}">
                                    <Border Style="{StaticResource TaskCard}" Opacity="0.88"
                                            Cursor="Hand" MouseLeftButtonUp="Task_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Checkmark (restore) -->
                                            <CheckBox Grid.Column="0" IsChecked="True"
                                                      Style="{StaticResource CheckmarkBox}"
                                                      ToolTip="Mark as pending"
                                                      VerticalAlignment="Center" Margin="0,0,10,0"
                                                      Click="Uncheck_Click"/>

                                            <!-- Title + number + completed time -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <Border Background="{DynamicResource TagBackground}"
                                                            CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding TaskNumberDisplay}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TagForeground}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontSize="13"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               TextDecorations="Strikethrough"
                                                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding CompletedAtDisplay}"
                                                           FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                                           Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <!-- Time badge -->
                                            <Border Grid.Column="2" VerticalAlignment="Center"
                                                    Background="{DynamicResource TagBackground}"
                                                    CornerRadius="4" Padding="7,3" Margin="6,0">
                                                <TextBlock Text="{Binding TimeDisplay}"
                                                           FontSize="11" FontFamily="Consolas"
                                                           Foreground="{DynamicResource AccentGreen}"/>
                                            </Border>

                                            <!-- View detail -->
                                            <Button Grid.Column="3" Style="{StaticResource IconButton}"
                                                    ToolTip="View details" Click="Detail_Click"
                                                    Margin="0,0,2,0">
                                                <TextBlock Text="👁" FontSize="13" Foreground="#60A5FA"/>
                                            </Button>

                                            <!-- Delete -->
                                            <Button Grid.Column="4" Style="{StaticResource IconButton}"
                                                    ToolTip="Delete permanently" Click="Delete_Click">
                                                <TextBlock Text="🗑" FontSize="13" Foreground="#F87171"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>

                            </ContentControl.Resources>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
