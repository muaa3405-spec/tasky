<Window x:Class="Tasky.Windows.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Viewer — Tasky"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Width="860" Height="620"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Open: fade + scale in -->
        <Storyboard x:Key="OpenAnim">
            <DoubleAnimation Storyboard.TargetName="Root"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.22"
                             EasingFunction="{x:Null}"/>
            <DoubleAnimation Storyboard.TargetName="ContentScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.90" To="1" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ContentScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.90" To="1" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Close: fade + scale out -->
        <Storyboard x:Key="CloseAnim" Completed="CloseAnim_Completed">
            <DoubleAnimation Storyboard.TargetName="Root"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.16"/>
            <DoubleAnimation Storyboard.TargetName="ContentScale"
                             Storyboard.TargetProperty="ScaleX"
                             To="0.90" Duration="0:0:0.16"/>
            <DoubleAnimation Storyboard.TargetName="ContentScale"
                             Storyboard.TargetProperty="ScaleY"
                             To="0.90" Duration="0:0:0.16"/>
        </Storyboard>
    </Window.Resources>

    <!-- Semi-transparent backdrop — click to close -->
    <Grid>
        <Rectangle Fill="#CC000000" MouseLeftButtonDown="Backdrop_Click"/>

        <!-- Viewer card -->
        <Border x:Name="Root" Background="#0F172A" CornerRadius="12"
                MaxWidth="820" MaxHeight="580"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" Color="#000"/>
            </Border.Effect>
            <Border.RenderTransform>
                <ScaleTransform x:Name="ContentScale" CenterX="410" CenterY="290"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- toolbar -->
                    <RowDefinition Height="*"/>     <!-- image -->
                    <RowDefinition Height="Auto"/>  <!-- filename -->
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Grid Grid.Row="0" Margin="16,14,16,0">
                    <TextBlock x:Name="TitleLabel" FontSize="13" FontWeight="SemiBold"
                               Foreground="#94A3B8" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Zoom out -->
                        <Button x:Name="ZoomOutBtn" Content="−" FontSize="16" FontWeight="Bold"
                                Foreground="White" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Padding="8,2" Click="ZoomOut_Click"
                                ToolTip="Zoom out  (scroll wheel)"/>
                        <!-- Zoom in -->
                        <Button x:Name="ZoomInBtn"  Content="+" FontSize="16" FontWeight="Bold"
                                Foreground="White" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Padding="8,2" Click="ZoomIn_Click"
                                ToolTip="Zoom in  (scroll wheel)"/>
                        <!-- Reset zoom -->
                        <Button Content="⊡" FontSize="14" Foreground="#94A3B8"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Padding="8,2" Click="ZoomReset_Click"
                                ToolTip="Reset zoom"/>
                        <!-- Close -->
                        <Button Content="✕" FontSize="14" Foreground="#EF4444"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Padding="8,2" Click="Close_Click"
                                ToolTip="Close  (Esc)"/>
                    </StackPanel>
                </Grid>

                <!-- Image area with scroll/zoom -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="Scroll_MouseWheel"
                              Margin="12,10">
                    <Image x:Name="MainImage"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="ImageScale" CenterX="0" CenterY="0"/>
                        </Image.RenderTransform>
                    </Image>
                </ScrollViewer>

                <!-- Navigation row (prev / filename / next) -->
                <Grid Grid.Row="2" Margin="16,8,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="◀" FontSize="14" Foreground="#94A3B8"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Padding="8,4" Click="Prev_Click"
                            x:Name="PrevBtn" IsEnabled="False"/>

                    <TextBlock Grid.Column="1" x:Name="FileLabel"
                               FontSize="11" Foreground="#64748B"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <Button Grid.Column="2" Content="▶" FontSize="14" Foreground="#94A3B8"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Padding="8,4" Click="Next_Click"
                            x:Name="NextBtn" IsEnabled="False"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
