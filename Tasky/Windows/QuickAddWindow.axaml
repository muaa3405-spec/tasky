<Window x:Class="Tasky.Windows.QuickAddWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Add – Tasky"
        Width="460" SizeToContent="Height"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        CanResize="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Deactivated="Window_Deactivated">

    <Border Background="White"
            CornerRadius="12"
            Padding="20,16">
        <Border.Effect>
            <DropShadowDirectionEffect BlurRadius="24" ShadowDepth="4" Opacity="0.2" Color="#000000"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="Quick Add Task" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>

            <Grid ColumnDefinitions="*,8,Auto">
                <TextBox x:Name="TitleBox"
                         Grid.Column="0"
                         Theme="{StaticResource InputBox}"
                         FontSize="15"
                         KeyDown="TitleBox_KeyDown"
                         Padding="12,10"/>

                <Button Grid.Column="2"
                        Theme="{StaticResource PrimaryButton}"
                        Content="Add"
                        Click="Add_Click"/>
            </Grid>

            <TextBlock Text="Press Enter to add • Esc to cancel"
                       Theme="{StaticResource SubText}"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</Window>
