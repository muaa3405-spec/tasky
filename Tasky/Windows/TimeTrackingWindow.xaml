<Window x:Class="Tasky.Windows.TimeTrackingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Tasky.ViewModels"
        Title="Time Tracking — Tasky"
        Width="680" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header + search -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⏱ Time Tracking" Style="{StaticResource HeadingText}" FontSize="18"/>
                <TextBox  Grid.Column="1"
                          Style="{StaticResource InputBox}"
                          Tag="Search by title or #ID…"
                          Text="{Binding CompletedSearch, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Border>

        <!-- Completed task list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
            <ItemsControl ItemsSource="{Binding FilteredCompleted}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TaskItemViewModel}">
                        <Border Style="{StaticResource TaskCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>   <!-- Task # -->
                                    <ColumnDefinition Width="*"/>    <!-- Title -->
                                    <ColumnDefinition Width="140"/>  <!-- Time -->
                                </Grid.ColumnDefinitions>

                                <!-- Task number badge -->
                                <Border Grid.Column="0" VerticalAlignment="Center"
                                        Background="{DynamicResource TagBackground}"
                                        CornerRadius="4" Padding="6,3" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding TaskNumberDisplay}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TagForeground}"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Title -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Description}"
                                               Style="{StaticResource SubText}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Description, Converter={StaticResource StringToVis}}"/>
                                </StackPanel>

                                <!-- Time spent -->
                                <Border Grid.Column="2" VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Background="{DynamicResource TagBackground}"
                                        CornerRadius="4" Padding="8,4">
                                    <TextBlock Text="{Binding TimeDisplay}"
                                               FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentGreen}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
