<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackground"      Color="#F9FAFB"/>
    <SolidColorBrush x:Key="CardBackground"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBackground"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderColor"        Color="#E5E7EB"/>
    <SolidColorBrush x:Key="TextPrimary"        Color="#111827"/>
    <SolidColorBrush x:Key="TextSecondary"      Color="#6B7280"/>
    <SolidColorBrush x:Key="PlaceholderColor"   Color="#9CA3AF"/>
    <SolidColorBrush x:Key="InputBackground"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryBlue"        Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentGreen"        Color="#22C55E"/>
    <SolidColorBrush x:Key="TagBackground"      Color="#EFF6FF"/>
    <SolidColorBrush x:Key="TagForeground"      Color="#3B82F6"/>
    <SolidColorBrush x:Key="ShadowColor"        Color="#000000"/>
    <SolidColorBrush x:Key="DialogFrameBorder"  Color="#3B82F6" Opacity="0.6"/>
    <SolidColorBrush x:Key="CompletedOpacity"   Color="#6B7280"/>
    <SolidColorBrush x:Key="CalendarDayTitle"   Color="#6B7280"/>
</ResourceDictionary>
