<Window x:Class="Tasky.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Tasky.ViewModels"
        xmlns:beh="clr-namespace:Tasky.Behaviors"
        xmlns:ctrl="clr-namespace:Tasky.Controls"
        Title="Tasky" Height="720" Width="620"
        MinWidth="460" MinHeight="460"
        Background="{DynamicResource AppBackground}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- MAIN HEADER -->
        <Border x:Name="MainHeader" Grid.Row="0"
                Background="{DynamicResource HeaderBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/tasky-logo.png" Width="32" Height="32"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Tasky" Style="{StaticResource HeadingText}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 🔔 Reminders — position 1 with missed-count badge -->
                    <Button Style="{StaticResource IconButton}" ToolTip="Reminders &amp; Notifications"
                            Click="Reminders_Click" Margin="0,0,4,0">
                        <Grid>
                            <TextBlock Text="&#x1F514;" FontSize="15" Foreground="#FB923C"/>
                            <Border x:Name="NotifBadge"
                                    Background="#EF4444" CornerRadius="7"
                                    MinWidth="14" Height="14"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-4,-4,0" Padding="3,0"
                                    Visibility="{Binding HasMissedNotifs, Converter={StaticResource BoolToVis}}">
                                <TextBlock x:Name="NotifBadgeText"
                                           Text="{Binding MissedNotifCount}"
                                           FontSize="9" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>
                    <!-- 📝 Notes -->
                    <Button Style="{StaticResource IconButton}" ToolTip="Notes"
                            Click="Notes_Click" Margin="0,0,4,0">
                        <TextBlock Text="&#x1F4DD;" FontSize="15" Foreground="#FCD34D"/>
                    </Button>
                    <!-- 📁 Groups -->
                    <Button Style="{StaticResource IconButton}" ToolTip="Manage Groups"
                            Click="Groups_Click" Margin="0,0,4,0">
                        <TextBlock Text="&#x1F4C1;" FontSize="15" Foreground="#60A5FA"/>
                    </Button>
                    <Border Width="1" Height="18" Background="{DynamicResource BorderColor}"
                            VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <!-- 📊 Stats -->
                    <Button Style="{StaticResource IconButton}" ToolTip="Stats &amp; Reports"
                            Click="Stats_Click" Margin="0,0,4,0">
                        <TextBlock Text="&#x1F4CA;" FontSize="15" Foreground="#A78BFA"/>
                    </Button>
                    <!-- ⚙ Settings -->
                    <Button Style="{StaticResource IconButton}" ToolTip="Settings"
                            Click="Settings_Click" Margin="0,0,2,0">
                        <TextBlock Text="&#x2699;" FontSize="16" Foreground="#94A3B8"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SUB-PAGE HEADER -->
        <Border x:Name="SubHeader" Grid.Row="0" Visibility="Collapsed"
                Background="{DynamicResource HeaderBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource SecondaryButton}"
                        Padding="12,7" Click="Back_Click" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2190;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Back" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1" x:Name="SubPageTitle"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- New Note: only visible on the Notes page -->
                    <Button x:Name="NewNoteBtn" Style="{StaticResource PrimaryButton}"
                            Padding="10,6" Margin="0,0,6,0"
                            Visibility="Collapsed"
                            Click="NewNote_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+" FontSize="16" Margin="0,-1,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="New Note" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Empty Bin: gray text link, only visible on the Recycle Bin page -->
                    <Button x:Name="EmptyBinBtn" Click="EmptyBin_Click" Margin="0,0,8,0"
                            Cursor="Hand" Background="Transparent" BorderThickness="0"
                            Visibility="Collapsed" ToolTip="Permanently delete all items in the bin">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock x:Name="EbTxt" Text="Empty Bin" FontSize="13"
                                           Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="EbTxt" Property="Foreground" Value="#F87171"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="ThemeToggle_Click" Margin="0,0,2,0">
                        <TextBlock x:Name="SubThemeIcon" Text="&#x1F319;" FontSize="15"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ADD PANEL -->
        <Border x:Name="AddPanelBorder" Grid.Row="1"
                Background="{DynamicResource HeaderBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="14,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="AddToggleBtn"
                            HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}"
                            Padding="14,7" Content="&#x2795;  New Task" Click="AddToggle_Click"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Style="{StaticResource FilterChip}" Content="All"
                                     IsChecked="{Binding FilterAll, Mode=OneWay}"
                                     Click="Filter_All_Click" GroupName="TF" Margin="0,0,5,0"/>
                        <RadioButton Style="{StaticResource FilterChip}" Content="Today"
                                     IsChecked="{Binding FilterToday, Mode=OneWay}"
                                     Click="Filter_Today_Click" GroupName="TF" Margin="0,0,5,0"/>
                        <RadioButton Style="{StaticResource FilterChip}" Content="This Week"
                                     IsChecked="{Binding FilterThisWeek, Mode=OneWay}"
                                     Click="Filter_ThisWeek_Click" GroupName="TF" Margin="0,0,5,0"/>
                        <Button ToolTip="Completed Tasks" Click="Completed_Click"
                                Padding="10,4" Cursor="Hand" BorderThickness="0"
                                Background="Transparent">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent"
                                            CornerRadius="20" Padding="10,4" BorderThickness="0">
                                        <TextBlock Text="&#x2611;" FontSize="16" Foreground="#34D399"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource TagBackground}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Add form -->
                <StackPanel x:Name="AddFormPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title — full width -->
                        <TextBox Grid.Row="0" x:Name="TitleInputBox"
                                 Style="{StaticResource InputBox}" Tag="Task title..."
                                 Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="TitleBox_KeyDown"/>

                        <!-- Description -->
                        <Grid Grid.Row="2">
                            <TextBox x:Name="DescInputBox"
                                     Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding HasTitle}"
                                     MinHeight="44" MaxHeight="100" TextWrapping="Wrap"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     AllowDrop="True" Drop="Desc_Drop" PreviewKeyDown="Desc_PreviewKeyDown">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource InputBox}">
                                        <Setter Property="Tag" Value="Description (optional)..."/>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Tag" Value=""/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <Border IsHitTestVisible="False" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    Background="{DynamicResource InputBackground}" Opacity="0.6"
                                    Visibility="{Binding HasTitle, Converter={StaticResource InvBoolToVis}}">
                                <TextBlock Text="Enter a title first..." Foreground="{DynamicResource PlaceholderColor}"
                                           FontSize="13" FontStyle="Italic"
                                           VerticalAlignment="Center" Margin="12,0"/>
                            </Border>
                        </Grid>

                        <!-- Attachment row: button + hint, with thumbnail previews -->
                        <Grid Grid.Row="4" Margin="0,2,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="&#x1F4CE;  Attach Image"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,6" FontSize="12"
                                        Click="AttachImage_Click"/>
                                <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                           Text="or paste / drop an image"
                                           FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                           Opacity="0.6" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- Thumbnail previews — shown once attachments are queued -->
                            <Border x:Name="PendingAttachPanel" Grid.Row="1"
                                    Visibility="Collapsed" Margin="0,8,0,0">
                                <WrapPanel x:Name="PendingAttachThumbs"/>
                            </Border>
                        </Grid>

                        <!-- Start / Group / Repeat -->
                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Start:" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0"/>
                                <DatePicker Style="{StaticResource ThemedDatePicker}"
                                            SelectedDate="{Binding NewDueDate, Mode=TwoWay}"
                                            SelectedDateFormat="Short"
                                            Width="148" FontSize="13"
                                            Language="sv-SE"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Group:" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0"/>
                                <ComboBox x:Name="NewTaskGroupPicker" Style="{StaticResource ThemedComboBox}"
                                          Width="110" FontSize="12"
                                          SelectionChanged="NewTaskGroup_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Repeat:" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0"/>
                                <ComboBox x:Name="NewTaskRecurrencePicker" Style="{StaticResource ThemedComboBox}"
                                          Width="90" FontSize="12"
                                          SelectionChanged="NewTaskRecurrence_Changed">
                                    <ComboBoxItem Content="None"    Tag="0" IsSelected="True"/>
                                    <ComboBoxItem Content="Daily"   Tag="1"/>
                                    <ComboBoxItem Content="Weekly"  Tag="2"/>
                                    <ComboBoxItem Content="Monthly" Tag="3"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Add Task button — right-aligned at the bottom -->
                        <Button Grid.Row="8"
                                HorizontalAlignment="Right"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddTaskCommand}"
                                Content="Add Task" Click="AddTask_Click"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- PAGE CONTAINER -->
        <Grid x:Name="PageContainer" Grid.Row="2">

            <!-- PAGE 1: Task list -->
            <Grid x:Name="TaskListPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Group filter chips — sticky bar -->
                <ScrollViewer x:Name="GroupFilterScroll" Grid.Row="0"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Background="{DynamicResource HeaderBackground}"
                              BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                              Padding="14,7" Visibility="Collapsed">
                    <StackPanel x:Name="GroupChipsPanel" Orientation="Horizontal"/>
                </ScrollViewer>

                <!-- Task search bar -->
                <Border Grid.Row="1" Background="{DynamicResource HeaderBackground}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                        Padding="14,8">
                    <TextBox Style="{StaticResource InputBox}" Tag="🔍  Search tasks..."
                             Text="{Binding TaskSearch, UpdateSourceTrigger=PropertyChanged}"/>
                </Border>

                <!-- Empty state — shown when VisibleTasks is empty -->
                <StackPanel Grid.Row="2"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasVisibleTasks, Converter={StaticResource InvBoolToVis}}"
                            IsHitTestVisible="False">
                    <TextBlock Text="✓" FontSize="40" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}" Opacity="0.3"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding EmptyTasksMessage}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center" Opacity="0.6"/>
                </StackPanel>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto" Padding="14,10">
                    <ItemsControl x:Name="TaskListControl"
                                  ItemsSource="{Binding VisibleTasks}"
                                  beh:DragDropBehavior.IsEnabled="True"
                                  DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Style.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                                    From="0,12,0,0" To="0,0,0,0" Duration="0:0:0.25">
                                                    <ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                                                </ThicknessAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TaskItemViewModel}">
                                <Border Style="{StaticResource TaskCard}"
                                        Background="{Binding IsActive, Converter={StaticResource ActiveBgConv}}"
                                        Padding="0">
                                    <Grid>
                                        <!-- Left colour strip -->
                                        <Border Width="10" HorizontalAlignment="Left"
                                                CornerRadius="8,0,0,8" Margin="-1,0,0,0"
                                                Visibility="{Binding GroupBadge, Converter={StaticResource StringToVis}}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding GroupColor}"/>
                                            </Border.Background>
                                        </Border>

                                        <Grid Margin="16,10,12,24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                      Style="{StaticResource CheckmarkBox}"
                                                      VerticalAlignment="Top" Margin="0,3,8,0"
                                                      Click="Checkbox_Click"/>
                                            <ToggleButton Grid.Column="1" Style="{StaticResource ActiveToggleSwitch}"
                                                          IsChecked="{Binding IsActive, Mode=OneWay}"
                                                          Click="ActiveToggle_Click"
                                                          VerticalAlignment="Top" Margin="0,3,10,0"/>
                                            <StackPanel Grid.Column="2" Cursor="Hand"
                                                        MouseLeftButtonUp="TaskContent_Click">
                                                <WrapPanel Margin="0,0,0,3">
                                                    <Border Background="{DynamicResource TagBackground}"
                                                            CornerRadius="3" Padding="4,1" Margin="0,2,4,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TaskNumberDisplay}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TagForeground}"/>
                                                    </Border>
                                                    <!-- Start date badge -->
                                                    <Border CornerRadius="3" Padding="4,1" Margin="0,2,4,2" VerticalAlignment="Center"
                                                            Visibility="{Binding DueDateTag, Converter={StaticResource StringToVis}}">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding DueDateColor}"/>
                                                        </Border.Background>
                                                        <TextBlock Text="{Binding DueDateTag}"
                                                                   FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                                    </Border>
                                                    <!-- Recurrence badge -->
                                                    <Border CornerRadius="3" Padding="4,1" Margin="0,2,6,2" VerticalAlignment="Center"
                                                            Visibility="{Binding RecurrenceDisplay, Converter={StaticResource StringToVis}}">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding RecurrenceHex}"/>
                                                        </Border.Background>
                                                        <TextBlock Text="{Binding RecurrenceDisplay}"
                                                                   FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                </WrapPanel>
                                                <StackPanel Visibility="{Binding Description, Converter={StaticResource StringToVis}}"
                                                            Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubText}">
                                                                <Setter Property="MaxHeight" Value="36"/>
                                                                <Setter Property="TextTrimming" Value="WordEllipsis"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDescriptionExpanded}" Value="True">
                                                                        <Setter Property="MaxHeight" Value="9999"/>
                                                                        <Setter Property="TextTrimming" Value="None"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Button Content="{Binding ShowMoreLabel}" HorizontalAlignment="Left"
                                                            Click="ShowMore_Click" Background="Transparent" BorderThickness="0"
                                                            Padding="0,2,0,0" Cursor="Hand"
                                                            Foreground="{DynamicResource PrimaryBlue}"
                                                            FontSize="11" FontFamily="Segoe UI"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock FontSize="11" Margin="0,0,4,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#x23F1;"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                                        <Setter Property="Text" Value="&#x23F8;"/>
                                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding ElapsedDisplay}"
                                                               FontSize="11" FontFamily="Consolas" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button Style="{StaticResource IconButton}" ToolTip="Pause / Resume"
                                                        Click="Pause_Click" Margin="0,0,1,0"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock FontSize="13" Foreground="#F59E0B">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#x23F8;"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                                        <Setter Property="Text" Value="&#x25B6;"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" ToolTip="Attachments"
                                                        Click="Attachment_Click" Margin="0,0,1,0">
                                                    <TextBlock Text="&#x1F4CE;" FontSize="13" Foreground="#60A5FA"/>
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" ToolTip="Edit"
                                                        Click="Edit_Click" Margin="0,0,1,0">
                                                    <TextBlock Text="&#x270F;" FontSize="13" Foreground="#A78BFA"/>
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" ToolTip="Set reminder"
                                                        Click="Reminder_Click" Margin="0,0,1,0">
                                                    <TextBlock Text="&#x1F514;" FontSize="13" Foreground="#FCD34D"/>
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" ToolTip="Delete"
                                                        Click="Delete_Click">
                                                    <TextBlock Text="&#x1F5D1;" FontSize="13" Foreground="#F87171"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Attachment + Reminder — bottom-right of card -->
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                    Margin="0,0,10,6" Panel.ZIndex="2">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0"
                                                        Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="&#x1F4CE;" FontSize="10" Margin="0,0,3,0"
                                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding AttachmentCountDisplay}" FontSize="10"
                                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding HasReminders, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="&#x1F514;" FontSize="10" Margin="0,0,3,0"
                                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ReminderCountDisplay}" FontSize="10"
                                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid><!-- end TaskListPage wrapper -->

            <!-- PAGE 2: Completed Tasks -->
            <Grid x:Name="CompletedPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                        Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="CChipAll"  Style="{StaticResource FilterChip}" Content="All"
                                         Tag="All" IsChecked="True" GroupName="CF" Margin="0,0,6,0"
                                         Click="CGroup_Click"/>
                            <RadioButton x:Name="CChipToday" Style="{StaticResource FilterChip}" Content="Today"
                                         Tag="Today" GroupName="CF" Margin="0,0,6,0" Click="CGroup_Click"/>
                            <RadioButton x:Name="CChipWeek"  Style="{StaticResource FilterChip}" Content="This Week"
                                         Tag="This Week" GroupName="CF" Margin="0,0,6,0" Click="CGroup_Click"/>
                            <RadioButton x:Name="CChipMonth" Style="{StaticResource FilterChip}" Content="This Month"
                                         Tag="This Month" GroupName="CF" Margin="0,0,6,0" Click="CGroup_Click"/>
                            <!-- Specific date filter -->
                            <DatePicker x:Name="CompletedDatePicker"
                                        Style="{StaticResource ThemedDatePicker}"
                                        Width="120" FontSize="12"
                                        SelectedDateChanged="CompletedDate_Changed"
                                        ToolTip="Filter by specific date"/>
                        </StackPanel>
                        <ComboBox x:Name="SortBox" Grid.Column="2"
                                  Style="{StaticResource ThemedComboBox}" Width="160" FontSize="12"
                                  SelectionChanged="Sort_Changed">
                            <ComboBoxItem Content="Newest first"      Tag="newest"    IsSelected="True"/>
                            <ComboBoxItem Content="Oldest first"      Tag="oldest"/>
                            <ComboBoxItem Content="Most time spent"   Tag="time_desc"/>
                            <ComboBoxItem Content="Least time spent"  Tag="time_asc"/>
                        </ComboBox>
                    </Grid>
                </Border>
                <!-- Completed search -->
                <Border Grid.Row="1" Background="{DynamicResource HeaderBackground}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                        Padding="14,8">
                    <TextBox Style="{StaticResource InputBox}" Tag="🔍  Search completed tasks..."
                             Text="{Binding CompletedSearch, UpdateSourceTrigger=PropertyChanged}"/>
                </Border>
                <!-- Empty state for completed list -->
                <StackPanel x:Name="CompletedEmptyState" Grid.Row="2"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock Text="☑" FontSize="40" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}" Opacity="0.3"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="No completed tasks to show."
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center" Opacity="0.6"/>
                </StackPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="14,10">
                    <ItemsControl x:Name="CompletedList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TaskItemViewModel}">
                                <Border Style="{StaticResource TaskCard}" Margin="0,0,0,8" Cursor="Hand"
                                        MouseLeftButtonUp="CompletedTask_Click">
                                    <Grid Margin="12,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Background="{DynamicResource TagBackground}"
                                                        CornerRadius="3" Padding="5,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding TaskNumberDisplay}"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TagForeground}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding CompletedAtDisplay}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding TimeDisplay}" FontSize="11"
                                                           Foreground="{DynamicResource AccentGreen}"
                                                           FontFamily="Consolas"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}"
                                                    ToolTip="Resume task (mark as incomplete)"
                                                    Click="Completed_Uncheck"
                                                    Margin="0,0,2,0">
                                                <TextBlock Text="&#x21BA;" FontSize="15"
                                                           Foreground="#A78BFA"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}"
                                                    ToolTip="Update time spent"
                                                    Click="CompletedUpdateTime_Click"
                                                    Margin="0,0,2,0">
                                                <TextBlock Text="⏱" FontSize="14"
                                                           Foreground="#60A5FA"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}"
                                                    ToolTip="Delete"
                                                    Click="CompletedDelete_Click">
                                                <TextBlock Text="&#x1F5D1;" FontSize="14"
                                                           Foreground="#F87171"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- PAGE 3: Notes -->
            <Grid x:Name="NotesPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Add note panel -->
                <Border x:Name="AddNotePanel" Grid.Row="0"
                        Visibility="Collapsed"
                        Background="{DynamicResource HeaderBackground}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                        Padding="14,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0" x:Name="NoteTitleBox" Style="{StaticResource InputBox}"
                                 Tag="Note title..." Text="{Binding NewNoteTitle, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Grid.Row="2" x:Name="NoteDescBox" Style="{StaticResource InputBox}"
                                 Tag="Note content (optional)..."
                                 Text="{Binding NewNoteDescription, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="60" MaxHeight="120" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"/>
                        <TextBox Grid.Row="4" x:Name="NoteTagsBox" Style="{StaticResource InputBox}"
                                 Tag="Search terms / tags (comma-separated)..."/>
                        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="Cancel" Margin="0,0,8,0"
                                    Click="CancelNote_Click"/>
                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="Add Note" Click="SaveNote_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Search -->
                <Border Grid.Row="1" Padding="14,8"
                        Background="{DynamicResource HeaderBackground}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                    <TextBox Style="{StaticResource InputBox}" Tag="Search notes..."
                             Text="{Binding NoteSearch, UpdateSourceTrigger=PropertyChanged}"/>
                </Border>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="14,10">
                    <StackPanel>
                        <TextBlock x:Name="NotesEmptyLabel" Text="No notes yet."
                                   Style="{StaticResource SubText}"
                                   HorizontalAlignment="Center" Margin="0,24,0,0"
                                   Visibility="Collapsed"/>
                        <ItemsControl x:Name="NotesList" ItemsSource="{Binding FilteredNotes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TaskCard}" Margin="0,0,0,8"
                                            Cursor="Hand" MouseLeftButtonUp="Note_Click">
                                        <Grid Margin="12,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           TextTrimming="CharacterEllipsis" MaxHeight="36"/>
                                                <!-- Tag chips (only rendered when there are tags) -->
                                                <ItemsControl ItemsSource="{Binding TagList}" Margin="0,5,0,0">
                                                    <ItemsControl.Style>
                                                        <Style TargetType="ItemsControl">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tags}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ItemsControl.Style>
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#1A3A5C" BorderBrush="#3B82F6"
                                                                    BorderThickness="1" CornerRadius="10"
                                                                    Padding="7,2" Margin="0,0,4,0">
                                                                <TextBlock Text="{Binding}" FontSize="10"
                                                                           Foreground="#60A5FA"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                                    VerticalAlignment="Center" Click="DeleteNote_Click">
                                                <TextBlock Text="&#x1F5D1;" FontSize="14" Foreground="#F87171"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- PAGE 4: Stats -->
            <Grid x:Name="StatsPage" Visibility="Collapsed">
                <ScrollViewer x:Name="StatsScrollViewer" VerticalScrollBarVisibility="Auto" Padding="14,12">
                    <StackPanel>
                        <!-- Summary cards row -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource TaskCard}" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="TODAY" Style="{StaticResource LabelText}"/>
                                    <TextBlock x:Name="StatTodayCount" FontSize="24" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryBlue}" Text="0"/>
                                    <TextBlock Text="completed" Style="{StaticResource SubText}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource TaskCard}" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="THIS WEEK" Style="{StaticResource LabelText}"/>
                                    <TextBlock x:Name="StatWeekCount" FontSize="24" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentGreen}" Text="0"/>
                                    <TextBlock Text="completed" Style="{StaticResource SubText}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource TaskCard}" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="TODAY TIME" Style="{StaticResource LabelText}"/>
                                    <TextBlock x:Name="StatTimeToday" FontSize="18" FontWeight="Bold"
                                               Foreground="#FB923C" FontFamily="Consolas" Text="0m"/>
                                    <TextBlock Text="tracked" Style="{StaticResource SubText}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="6" Style="{StaticResource TaskCard}" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="ALL TIME" Style="{StaticResource LabelText}"/>
                                    <TextBlock x:Name="StatAllTime" FontSize="18" FontWeight="Bold"
                                               Foreground="#A78BFA" FontFamily="Consolas" Text="0m"/>
                                    <TextBlock Text="tracked" Style="{StaticResource SubText}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Meeting Hours (auto-detected: meeting app + mic/camera) -->
                        <Border Style="{StaticResource TaskCard}" Padding="14,12" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Meeting Hours" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <RadioButton x:Name="MeetingFilterToday" GroupName="MeetingFilter"
                                                     Style="{StaticResource FilterChip}" Content="Today"
                                                     Tag="today" Click="MeetingFilter_Click" Margin="0,0,4,0"/>
                                        <RadioButton x:Name="MeetingFilterWeek" GroupName="MeetingFilter"
                                                     Style="{StaticResource FilterChip}" Content="This Week"
                                                     Tag="week" IsChecked="True"
                                                     Click="MeetingFilter_Click" Margin="0,0,4,0"/>
                                        <RadioButton x:Name="MeetingFilterMonth" GroupName="MeetingFilter"
                                                     Style="{StaticResource FilterChip}" Content="This Month"
                                                     Tag="month" Click="MeetingFilter_Click"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="StatMeetingDisplay"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="#34D399" FontFamily="Consolas" Text="—"/>
                                <TextBlock Text="meeting app + mic/camera detected"
                                           Style="{StaticResource SubText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Last 7 Days — task count + time spent, with week navigation -->
                        <Border Style="{StaticResource TaskCard}" Padding="14,12" Margin="0,0,0,16">
                            <StackPanel>
                                <!-- Header with week navigation -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Last 7 Days" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="PrevWeekBtn" Style="{StaticResource IconButton}"
                                                Click="PrevWeek_Click" ToolTip="Previous week">
                                            <TextBlock Text="&#x2190;" FontSize="13"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                        </Button>
                                        <TextBlock x:Name="WeekLabel" Text="" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" Margin="4,0"/>
                                        <Button x:Name="NextWeekBtn" Style="{StaticResource IconButton}"
                                                Click="NextWeek_Click" ToolTip="Next week" IsEnabled="False">
                                            <TextBlock Text="&#x2192;" FontSize="13"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <!-- Two charts side by side -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Tasks completed" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <StackPanel x:Name="BarChartPanel" Orientation="Horizontal"
                                                    VerticalAlignment="Bottom" MinHeight="80"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Time spent" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <StackPanel x:Name="TimeChartPanel" Orientation="Horizontal"
                                                    VerticalAlignment="Bottom" MinHeight="80"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Top tasks -->
                        <Border Style="{StaticResource TaskCard}" Padding="14,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Most Time Spent" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <RadioButton x:Name="TopToday"   GroupName="TopFilter"
                                                     Style="{StaticResource FilterChip}" Content="Today"
                                                     Tag="today"   Margin="0,0,4,0" Click="TopFilter_Click"/>
                                        <RadioButton x:Name="TopWeek"    GroupName="TopFilter"
                                                     Style="{StaticResource FilterChip}" Content="Week"
                                                     Tag="week"    Margin="0,0,4,0" Click="TopFilter_Click"/>
                                        <RadioButton x:Name="TopMonth"   GroupName="TopFilter"
                                                     Style="{StaticResource FilterChip}" Content="Month"
                                                     Tag="month"   Margin="0,0,4,0" Click="TopFilter_Click"/>
                                        <RadioButton x:Name="TopOverall" GroupName="TopFilter"
                                                     Style="{StaticResource FilterChip}" Content="Overall"
                                                     Tag="overall" IsChecked="True" Click="TopFilter_Click"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="TopTasksPanel"/>
                                <TextBlock x:Name="TopTasksEmpty"
                                           Text="No tracked time yet."
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,4" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- Busiest Hour -->
                        <Border Style="{StaticResource TaskCard}" Padding="14,12" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Busiest Hour" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Avg completions per active day  ·  7 AM – 9 PM  ·  last 30 days"
                                           FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,2,0,10"/>
                                <StackPanel x:Name="BusiestHourPanel" Orientation="Horizontal"
                                            VerticalAlignment="Bottom"/>
                                <TextBlock x:Name="BusiestHourEmpty"
                                           Text="No completion data yet."
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,4" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- Weekly Summary (time or task count toggle) -->
                        <Border Style="{StaticResource TaskCard}" Padding="14,12" Margin="0,16,0,0">
                            <StackPanel>
                                <!-- Header with Time / Tasks toggle -->
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Weekly Summary" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="WeeklyTimeToggle" GroupName="WeeklyMode"
                                                     Style="{StaticResource FilterChip}" Content="Time"
                                                     IsChecked="True" Click="WeeklyToggle_Click" Margin="0,0,4,0"/>
                                        <RadioButton x:Name="WeeklyTaskToggle" GroupName="WeeklyMode"
                                                     Style="{StaticResource FilterChip}" Content="Tasks"
                                                     Click="WeeklyToggle_Click"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Avg per active month  ·  last 12 months  ·  W1 = days 1–7,  W4 = days 22–end"
                                           FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,2,0,10"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              PreviewMouseWheel="InnerScroll_PreviewMouseWheel">
                                    <StackPanel x:Name="WeeklyChartPanel" Orientation="Horizontal"
                                                VerticalAlignment="Bottom"/>
                                </ScrollViewer>
                                <TextBlock x:Name="WeeklyChartEmpty"
                                           Text="No tracked time yet."
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,4" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- App Usage -->
                        <Border Style="{StaticResource TaskCard}" Padding="14,12" Margin="0,16,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="App Usage" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Time spent in each Windows application  ·  top 10"
                                                   FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <RadioButton x:Name="AppUsageToday" GroupName="AppUsageFilter"
                                                     Style="{StaticResource FilterChip}" Content="Today"
                                                     IsChecked="True" Tag="today"
                                                     Click="AppUsageFilter_Click" Margin="0,0,4,0"/>
                                        <RadioButton x:Name="AppUsageWeek" GroupName="AppUsageFilter"
                                                     Style="{StaticResource FilterChip}" Content="This Week"
                                                     Tag="week" Click="AppUsageFilter_Click" Margin="0,0,4,0"/>
                                        <RadioButton x:Name="AppUsageMonth" GroupName="AppUsageFilter"
                                                     Style="{StaticResource FilterChip}" Content="Month"
                                                     Tag="month" Click="AppUsageFilter_Click" Margin="0,0,8,0"/>
                                        <Button Click="AppUsageRefresh_Click"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="Refresh app usage"
                                                Width="26" Height="26" Padding="0">
                                            <TextBlock Text="&#x21BB;" FontSize="13"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="AppUsagePanel"/>
                                <TextBlock x:Name="AppUsageEmpty"
                                           Text="No app usage data yet — start using apps and check back."
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap" Margin="0,4" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- PAGE 5: Notifications & Reminders -->
            <Grid x:Name="RemindersPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Full-width segmented tab bar -->
                <Grid Grid.Row="0" Background="{DynamicResource HeaderBackground}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="NotifTabBtn" Grid.Column="0"
                                 GroupName="ReminderTabs" IsChecked="True"
                                 Click="NotifTab_Click" Cursor="Hand">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bd" BorderThickness="0,0,0,3"
                                        BorderBrush="Transparent" Padding="0,11"
                                        Background="Transparent">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#x1F514;" FontSize="13"
                                                   Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="Lbl" Text="Notifications"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd"  Property="BorderBrush" Value="#60A5FA"/>
                                        <Setter TargetName="Lbl" Property="Foreground"  Value="#60A5FA"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TagBackground}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                    <RadioButton x:Name="UpcomingTabBtn" Grid.Column="1"
                                 GroupName="ReminderTabs"
                                 Click="UpcomingTab_Click" Cursor="Hand">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bd" BorderThickness="0,0,0,3"
                                        BorderBrush="Transparent" Padding="0,11"
                                        Background="Transparent">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#x23F0;" FontSize="13"
                                                   Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="Lbl" Text="Upcoming Reminders"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd"  Property="BorderBrush" Value="#60A5FA"/>
                                        <Setter TargetName="Lbl" Property="Foreground"  Value="#60A5FA"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TagBackground}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                    <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="1"
                            Background="{DynamicResource BorderColor}"/>
                </Grid>

                <!-- TAB 1: Notifications -->
                <ScrollViewer x:Name="NotifPanel" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto" Padding="14,12">
                    <StackPanel>
                        <!-- NEW (unread) -->
                        <StackPanel x:Name="MissedSection" Visibility="Collapsed" Margin="0,0,0,8">
                            <TextBlock Text="NEW" FontSize="10" FontWeight="Bold"
                                       Foreground="#EF4444" Margin="0,0,0,6"/>
                            <ItemsControl x:Name="MissedList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" CornerRadius="8"
                                                Cursor="Hand" MouseLeftButtonUp="MissedNotif_Click"
                                                Background="#1E3A5F" BorderBrush="#60A5FA"
                                                BorderThickness="0,0,0,2" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <Border Background="{DynamicResource TagBackground}"
                                                                CornerRadius="3" Padding="5,1" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding TaskIdDisplay}"
                                                                       FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TagForeground}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding TaskTitle}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock FontSize="11" Foreground="#93C5FD">
                                                        <Run Text="&#x23F0; "/>
                                                        <Run Text="{Binding FiredAtDisplay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- SEEN (read) -->
                        <StackPanel x:Name="ReadSection" Visibility="Collapsed">
                            <TextBlock Text="SEEN" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,0,0,6" Opacity="0.7"/>
                            <ItemsControl x:Name="ReadList" Opacity="0.65">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" CornerRadius="8"
                                                Cursor="Hand" MouseLeftButtonUp="ReadNotif_Click"
                                                Background="{DynamicResource AppBackground}"
                                                BorderBrush="{DynamicResource BorderColor}"
                                                BorderThickness="1" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <Border Background="{DynamicResource TagBackground}"
                                                                CornerRadius="3" Padding="5,1" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding TaskIdDisplay}"
                                                                       FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TagForeground}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding TaskTitle}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock FontSize="11"
                                                               Foreground="{DynamicResource TextSecondary}">
                                                        <Run Text="&#x23F0; "/>
                                                        <Run Text="{Binding FiredAtDisplay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                                        ToolTip="Delete" VerticalAlignment="Center"
                                                        Tag="{Binding Id}" Click="DismissMissedNotif_Click">
                                                    <TextBlock Text="&#x1F5D1;" FontSize="13" Foreground="#F87171"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock x:Name="NotifEmptyLabel" Text="No notifications yet."
                                   Style="{StaticResource SubText}"
                                   HorizontalAlignment="Center" Margin="0,32,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 2: Upcoming Reminders -->
                <ScrollViewer x:Name="UpcomingPanel" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto" Padding="14,12"
                              Visibility="Collapsed">
                    <StackPanel>
                        <ItemsControl x:Name="RemindersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TaskCard}" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="12,10,0,10">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Border Background="{DynamicResource TagBackground}"
                                                            CornerRadius="3" Padding="5,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding TaskIdDisplay}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TagForeground}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding TaskTitle}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#x23F0; " FontSize="11"
                                                               Foreground="#FB923C" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FireDisplay}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="#FB923C" Margin="0,0,10,0"
                                                               VerticalAlignment="Center"/>
                                                    <Border Background="{DynamicResource TagBackground}"
                                                            CornerRadius="3" Padding="5,2">
                                                        <TextBlock Text="{Binding FrequencyDisplay}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondary}"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                                    ToolTip="Delete reminder" VerticalAlignment="Center"
                                                    Margin="0,0,8,0"
                                                    Tag="{Binding Id}" Click="DeleteReminder_Click">
                                                <TextBlock Text="&#x1F5D1;" FontSize="14" Foreground="#F87171"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="RemindersEmptyLabel"
                                   Text="No upcoming reminders scheduled."
                                   Style="{StaticResource SubText}"
                                   HorizontalAlignment="Center" Margin="0,32,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ── PAGE: Settings ──────────────────────────────────────── -->
            <Grid x:Name="SettingsPage" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,16,20,16">

                    <!-- ROW 1: Profile + Appearance side by side — equal height via Grid stretch -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Labels -->
                        <TextBlock Grid.Column="0" Grid.Row="0"
                                   Text="PROFILE" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                        <TextBlock Grid.Column="2" Grid.Row="0"
                                   Text="APPEARANCE" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>

                        <!-- Profile card -->
                        <Border Grid.Column="0" Grid.Row="1"
                                Style="{StaticResource TaskCard}" Padding="14,12"
                                VerticalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="Name" FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                                <TextBox x:Name="SettingUserName" Style="{StaticResource InputBox}"
                                         Tag="e.g. Muhammad Aadil"
                                         TextChanged="SettingUserName_Changed"/>
                            </StackPanel>
                        </Border>

                        <!-- Appearance card — VerticalAlignment=Stretch matches Profile height -->
                        <Border Grid.Column="2" Grid.Row="1"
                                Style="{StaticResource TaskCard}" Padding="14,12"
                                VerticalAlignment="Stretch">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Theme" FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ThemeDark"  GroupName="ThemeSetting"
                                                 Style="{StaticResource FilterChip}" Content="🌙  Dark"
                                                 Margin="0,0,6,0" Click="ThemeSetting_Click" Tag="dark"/>
                                    <RadioButton x:Name="ThemeLight" GroupName="ThemeSetting"
                                                 Style="{StaticResource FilterChip}" Content="☀️  Light"
                                                 Margin="0,0,6,0" Click="ThemeSetting_Click" Tag="light"/>
                                    <RadioButton x:Name="ThemeAuto"  GroupName="ThemeSetting"
                                                 Style="{StaticResource FilterChip}" Content="⚡  Auto"
                                                 Click="ThemeSetting_Click" Tag="auto"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ROW 2: Reminder Notifications — full width, stacked rows -->
                    <TextBlock Text="REMINDER NOTIFICATIONS" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <Border Style="{StaticResource TaskCard}" Padding="14,14" Margin="0,0,0,14">
                        <StackPanel>

                            <!-- Alert sound -->
                            <TextBlock Text="Alert sound" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" x:Name="SettingTune"
                                          Style="{StaticResource ThemedComboBox}"
                                          SelectionChanged="SettingTune_Changed">
                                    <ComboBoxItem Content="Windows Notify"  Tag="notify"/>
                                    <ComboBoxItem Content="Message Nudge"   Tag="nudge"/>
                                    <ComboBoxItem Content="Notify Calendar" Tag="calendar"/>
                                    <ComboBoxItem Content="Notify Email"    Tag="email"/>
                                    <ComboBoxItem Content="Proximity Alert" Tag="proximity" IsSelected="True"/>
                                    <ComboBoxItem Content="Windows Logon"   Tag="logon"/>
                                    <ComboBoxItem Content="No sound"        Tag="none"/>
                                </ComboBox>
                                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                        Padding="0" Height="32" Width="32"
                                        ToolTip="Preview sound" Click="PreviewTune_Click">
                                    <TextBlock Text="&#x25B6;" FontSize="11" Foreground="#60A5FA"/>
                                </Button>
                            </Grid>

                            <!-- Accent color -->
                            <TextBlock Text="Accent color" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton x:Name="AccentBlue"   GroupName="AccentColor"
                                             Style="{StaticResource FilterChip}" Content="Blue"
                                             Tag="#60A5FA" Margin="0,0,6,0" Click="AccentColor_Click"/>
                                <RadioButton x:Name="AccentGreen"  GroupName="AccentColor"
                                             Style="{StaticResource FilterChip}" Content="Green"
                                             Tag="#22C55E" Margin="0,0,6,0" Click="AccentColor_Click"/>
                                <RadioButton x:Name="AccentOrange" GroupName="AccentColor"
                                             Style="{StaticResource FilterChip}" Content="Orange"
                                             Tag="#FB923C" Margin="0,0,6,0" Click="AccentColor_Click"/>
                                <RadioButton x:Name="AccentPurple" GroupName="AccentColor"
                                             Style="{StaticResource FilterChip}" Content="Purple"
                                             Tag="#A78BFA" Click="AccentColor_Click"/>
                            </StackPanel>

                            <!-- Auto-dismiss -->
                            <TextBlock Text="Auto-dismiss" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton x:Name="DismissPerm" GroupName="DismissTime"
                                             Style="{StaticResource FilterChip}" Content="Permanent"
                                             Tag="0" Margin="0,0,6,0" Click="DismissTime_Click"/>
                                <RadioButton x:Name="Dismiss15"   GroupName="DismissTime"
                                             Style="{StaticResource FilterChip}" Content="15 s"
                                             Tag="15" Margin="0,0,6,0" Click="DismissTime_Click"/>
                                <RadioButton x:Name="Dismiss30"   GroupName="DismissTime"
                                             Style="{StaticResource FilterChip}" Content="30 s"
                                             Tag="30" Margin="0,0,6,0" Click="DismissTime_Click"/>
                                <RadioButton x:Name="Dismiss60"   GroupName="DismissTime"
                                             Style="{StaticResource FilterChip}" Content="60 s"
                                             Tag="60" Click="DismissTime_Click"/>
                            </StackPanel>

                            <!-- Test notification -->
                            <TextBlock Text="Test notification" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <Button x:Name="TestNotifBtn" Click="TestNotification_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left" Padding="14,7"
                                    ToolTip="Fire a real reminder to verify your settings">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x1F514;" FontSize="13" Margin="0,0,7,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Send test notification" FontSize="12"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </Border>

                    <!-- ROW 3: Task Completion -->
                    <TextBlock Text="TASK COMPLETION" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <Border Style="{StaticResource TaskCard}" Padding="14,12" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Show completion popup"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Celebration dialog with confetti when a task is marked done"
                                           Style="{StaticResource SubText}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          x:Name="CompletionPopupToggle"
                                          Style="{StaticResource ActiveToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Click="CompletionPopupToggle_Click"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource TaskCard}" Padding="14,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Save screenshot to Desktop"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="When off, the banner is only copied to clipboard"
                                           Style="{StaticResource SubText}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          x:Name="SaveScreenshotToggle"
                                          Style="{StaticResource ActiveToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Click="SaveScreenshotToggle_Click"/>
                        </Grid>
                    </Border>

                    <!-- ROW 5: Data / Recycle Bin + Meeting History -->
                    <TextBlock Text="DATA" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <Button Click="OpenTrash_Click" Cursor="Hand"
                            HorizontalAlignment="Stretch"
                            Background="Transparent" BorderThickness="0" Padding="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Style="{StaticResource TaskCard}" Padding="14,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#x1F5D1;" FontSize="16"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Recycle Bin" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="View and restore deleted tasks"
                                                       Style="{StaticResource SubText}" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="&#x203A;" FontSize="18"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Clear meeting history -->
                    <Border Style="{StaticResource TaskCard}" Padding="14,11" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#x1F4F9;" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Meeting History" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Clear all auto-detected meeting sessions"
                                           Style="{StaticResource SubText}" Margin="0,1,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="ClearMeetingHistoryBtn"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,6" Click="ClearMeetingHistory_Click"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Clear" FontSize="12"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Migrate to another computer (encrypted export / import) -->
                    <Border Style="{StaticResource TaskCard}" Padding="14,11" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#x1F4BB;" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Migrate to another computer" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Export everything to one password-protected file, or import it on a new PC"
                                           Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                                    Padding="12,6" Click="Migrate_Click"
                                    VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="Open" FontSize="12"/>
                            </Button>
                        </Grid>
                    </Border>

                </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- PAGE: Recycle Bin -->
            <Grid x:Name="TrashPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Info banner -->
                <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                        Padding="14,10">
                    <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="12"
                               TextWrapping="Wrap"
                               Text="Deleted tasks are kept here for 30 days, then removed automatically. Restore puts a task back in its list."/>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,10">
                    <Grid>
                        <!-- Empty state -->
                        <StackPanel x:Name="TrashEmptyState" VerticalAlignment="Center"
                                    HorizontalAlignment="Center" Margin="0,60,0,0">
                            <TextBlock Text="&#x1F5D1;" FontSize="40" HorizontalAlignment="Center"
                                       Opacity="0.5" Margin="0,0,0,10"/>
                            <TextBlock Text="The recycle bin is empty"
                                       Foreground="{DynamicResource TextSecondary}" FontSize="14"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl x:Name="TrashList" ItemsSource="{Binding DeletedTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TaskItemViewModel}">
                                    <Border Style="{StaticResource TaskCard}" Margin="0,0,0,8">
                                        <Grid Margin="12,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Border Background="{DynamicResource TagBackground}"
                                                            CornerRadius="3" Padding="5,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding TaskNumberDisplay}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TagForeground}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DeletedAtDisplay}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource IconButton}"
                                                        ToolTip="Restore" Click="Restore_Click" Margin="0,0,4,0">
                                                    <TextBlock Text="&#x21BA;" FontSize="15" Foreground="#22C55E"/>
                                                </Button>
                                                <Button Style="{StaticResource IconButton}"
                                                        ToolTip="Delete permanently" Click="PermanentDelete_Click">
                                                    <TextBlock Text="&#x1F5D1;" FontSize="14" Foreground="#F87171"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Grid>

        </Grid><!-- end page container -->


        <!-- Dim + blur overlay for modal dialogs -->
        <Border x:Name="DimOverlay" Grid.Row="0" Grid.RowSpan="3"
                Background="#AA000000"
                Visibility="Collapsed"
                Panel.ZIndex="997"/>

        <!-- ═══ In-app notification overlay (bottom-right inside window) ═══ -->
        <Border x:Name="InAppNotifBorder" Grid.Row="0" Grid.RowSpan="3"
                VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Margin="0,0,16,16"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Panel.ZIndex="999">
            <Border x:Name="NotifMainBorder"
                    Background="#1F2937"
                    CornerRadius="10" Padding="0"
                    MinWidth="280" MaxWidth="380">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.3" Color="#000"/>
                </Border.Effect>
                <Grid>
                    <Border x:Name="NotifAccent" Width="4" HorizontalAlignment="Left"
                            CornerRadius="10,0,0,10" Background="#22C55E"/>
                    <StackPanel Orientation="Horizontal" Margin="16,12,16,12">
                        <TextBlock x:Name="NotifIcon" FontSize="16"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="NotifMessage"
                                   Foreground="White" FontSize="12"
                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                   MaxWidth="300"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Confetti canvas -->
        <Canvas x:Name="ConfettiLayer" Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False"
                Panel.ZIndex="1000"/>

    </Grid>
</Window>
